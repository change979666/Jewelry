---
// /admin-v2/dashboard — 老板驾驶舱
// 与 /admin-v2（index）共用 DashboardView，保证两个路由完全一致
import DashboardView from "../../../components/admin/views/DashboardView.astro";
import { getCollection } from "astro:content";

// 只统计真实存在的内容集合（products / caseStudies 集合已移除）
const [blogC, guideC] = await Promise.all([getCollection("blog"), getCollection("guides")]);
const contentStats = {
  blog: blogC.length,
  guides: guideC.length,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>总览 — Jewelry 后台管理</title>
    <script is:inline>
      (function () {
        fetch("/api/admin/v2/auth/me", { credentials: "same-origin" })
          .then(function (r) {
            if (r.status === 401) window.location.replace("/admin-v2/login");
          })
          .catch(function () {
            window.location.replace("/admin-v2/login");
          });
      })();
    </script>
  </head>
  <body>
    <DashboardView contentStats={contentStats} />
  </body>
</html>
