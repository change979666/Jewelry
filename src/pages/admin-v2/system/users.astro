---
// Phase 2 — User Management Page
// Lists users, supports create/edit/delete (Owner/Admin only)
import "../../../styles/admin-v2.css";
import AdminShell from "../../../components/admin/layout/AdminShell.astro";
import Sidebar from "../../../components/admin/layout/Sidebar.astro";
import Topbar from "../../../components/admin/layout/Topbar.astro";
import Toast from "../../../components/admin/shared/Toast.astro";
import Skeleton from "../../../components/admin/shared/Skeleton.astro";
---

<AdminShell title="用户管理" activeModule="system">
  <Sidebar slot="sidebar" activeModule="system" />
  <Topbar
    slot="topbar-left"
    title="用户管理"
    breadcrumbs={[{ label: "系统", href: "/admin-v2/system" }, { label: "用户管理" }]}
  />
  <Toast />

  <div class="admin-page-header admin-flex admin-items-center admin-justify-between">
    <h1 class="admin-page-title">用户列表</h1>
    <button class="admin-btn admin-btn-primary" id="btn-create-user">+ 新建用户</button>
  </div>

  <div id="user-list-container">
    <Skeleton lines={5} height="40px" />
  </div>

  <!-- Create/Edit Dialog (hidden) -->
  <div id="user-form-overlay" style="display:none;" class="admin-modal-overlay">
    <div class="admin-modal">
      <div class="admin-modal-header" id="user-form-title">新建用户</div>
      <div class="admin-modal-body">
        <div class="admin-flex-col admin-gap-4">
          <div class="admin-form-group">
            <label class="admin-label">用户名</label>
            <input
              type="text"
              id="user-username"
              placeholder="用户名"
              class="admin-input"
              style="width:100%;"
            />
          </div>
          <div class="admin-form-group">
            <label class="admin-label">密码 Password</label>
            <input
              type="password"
              id="user-password"
              placeholder="密码"
              class="admin-input"
              style="width:100%;"
            />
          </div>
          <div class="admin-form-group">
            <label class="admin-label">角色</label>
            <select id="user-role" class="admin-select" style="width:100%;">
              <option value="role_owner">Owner（老板）</option>
              <option value="role_admin">Admin（管理员）</option>
              <option value="role_editor">Editor（编辑）</option>
              <option value="role_viewer">Viewer（查看）</option>
            </select>
          </div>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button class="admin-btn admin-btn-secondary" id="btn-user-cancel">取消</button>
        <button class="admin-btn admin-btn-primary" id="btn-user-save">保存</button>
      </div>
    </div>
  </div>
</AdminShell>

<script>
  const container = document.getElementById("user-list-container");
  const overlay = document.getElementById("user-form-overlay")!;
  let editingUserId: string | null = null;

  async function loadUsers() {
    container!.innerHTML =
      '<div class="admin-skeleton" style="height:40px;margin-bottom:8px;"></div>'.repeat(5);
    try {
      const res = await fetch("/api/admin/v2/system/users");
      const json = (await res.json()) as any;
      if (!json.success) {
        container!.innerHTML = `<div class="admin-error"><div class="admin-error-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div><div class="admin-error-title">加载失败</div><div class="admin-error-desc">${json.error?.message || "Unknown error"}</div></div>`;
        return;
      }
      const users = json.data || [];
      if (users.length === 0) {
        container!.innerHTML =
          '<div class="admin-empty"><div class="admin-empty-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="admin-empty-title">暂无用户</div></div>';
        return;
      }

      let html = '<div class="admin-table-wrapper"><table class="admin-table">';
      html +=
        "<thead><tr><th>用户</th><th>角色</th><th>状态</th><th>最后登录</th><th>操作</th></tr></thead><tbody>";
      for (const u of users) {
        html += `<tr>
          <td style="font-weight:500;">${u.username}</td>
          <td>${u.role_name || u.role_id}</td>
          <td><span class="admin-badge ${u.status === "active" ? "admin-badge-active" : "admin-badge-draft"}">${u.status === "active" ? "启用" : "禁用"}</span></td>
          <td class="admin-text-muted">${u.last_login_at || "—"}</td>
          <td>
            <div class="admin-flex admin-gap-1" style="flex-wrap:wrap;">
              <button class="admin-btn admin-btn-ghost admin-btn-sm" data-edit="${u.id}" data-username="${u.username}" data-role="${u.role_id}">编辑</button>
              <button class="admin-btn admin-btn-ghost admin-btn-sm" data-status-toggle="${u.id}" data-new-status="${u.status === "active" ? "disabled" : "active"}" style="color:var(--admin-warning);">${u.status === "active" ? "禁用" : "启用"}</button>
              <button class="admin-btn admin-btn-ghost admin-btn-sm" data-delete="${u.id}" style="color:var(--admin-danger);">删除</button>
            </div>
          </td>
        </tr>`;
      }
      html += "</tbody></table></div>";
      container!.innerHTML = html;
      container!
        .querySelectorAll("[data-edit]")
        .forEach((btn) =>
          btn.addEventListener("click", () =>
            openEdit(
              btn.getAttribute("data-edit")!,
              btn.getAttribute("data-username")!,
              btn.getAttribute("data-role")!,
            ),
          ),
        );
      container!
        .querySelectorAll("[data-delete]")
        .forEach((btn) =>
          btn.addEventListener("click", () => deleteUser(btn.getAttribute("data-delete")!)),
        );
      container!
        .querySelectorAll("[data-status-toggle]")
        .forEach((btn) =>
          btn.addEventListener("click", () =>
            toggleStatus(
              btn.getAttribute("data-status-toggle")!,
              btn.getAttribute("data-new-status")!,
            ),
          ),
        );
    } catch (_e) {
      container!.innerHTML =
        '<div class="admin-error"><div class="admin-error-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div><div class="admin-error-title">网络错误</div></div>';
    }
  }

  async function toggleStatus(id: string, newStatus: string) {
    const action = newStatus === "disabled" ? "禁用" : "启用";
    if (!confirm(`确定${action}此用户？`)) return;
    try {
      const res = await fetch(`/api/admin/v2/system/users/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newStatus }),
      });
      const json = (await res.json()) as any;
      (window as any).JewelryToast?.show({
        message: json.success ? `用户已${action}` : json.error?.message || `${action}失败`,
        type: json.success ? "success" : "error",
      });
      loadUsers();
    } catch (_e) {
      (window as any).JewelryToast?.show({ message: "网络错误", type: "error" });
    }
  }

  function openEdit(id: string, username: string, roleId: string) {
    editingUserId = id;
    document.getElementById("user-form-title")!.textContent = "编辑用户";
    (document.getElementById("user-username") as HTMLInputElement).value = username;
    (document.getElementById("user-password") as HTMLInputElement).value = "";
    (document.getElementById("user-password") as HTMLInputElement).placeholder = "留空则不修改密码";
    (document.getElementById("user-role") as unknown as HTMLSelectElement).value = roleId;
    overlay.style.display = "flex";
  }

  async function deleteUser(id: string) {
    if (!confirm("确定删除此用户？")) return;
    try {
      const res = await fetch(`/api/admin/v2/system/users/${id}`, { method: "DELETE" });
      const json = (await res.json()) as any;
      (window as any).JewelryToast?.show({
        message: json.success ? "用户已删除" : json.error?.message || "删除失败",
        type: json.success ? "success" : "error",
      });
      loadUsers();
    } catch (_e) {
      (window as any).JewelryToast?.show({ message: "网络错误", type: "error" });
    }
  }

  document.getElementById("btn-create-user")!.addEventListener("click", () => {
    editingUserId = null;
    document.getElementById("user-form-title")!.textContent = "新建用户";
    (document.getElementById("user-username") as HTMLInputElement).value = "";
    (document.getElementById("user-password") as HTMLInputElement).value = "";
    (document.getElementById("user-password") as HTMLInputElement).placeholder = "密码";
    (document.getElementById("user-role") as unknown as HTMLSelectElement).value = "role_editor";
    overlay.style.display = "flex";
  });

  document.getElementById("btn-user-cancel")!.addEventListener("click", () => {
    overlay.style.display = "none";
  });
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) overlay.style.display = "none";
  });

  document.getElementById("btn-user-save")!.addEventListener("click", async () => {
    const username = (document.getElementById("user-username") as HTMLInputElement).value.trim();
    const password = (document.getElementById("user-password") as HTMLInputElement).value;
    const roleId = (document.getElementById("user-role") as unknown as HTMLSelectElement).value;
    if (!username) {
      (window as any).JewelryToast?.show({ message: "用户名不能为空", type: "error" });
      return;
    }

    if (editingUserId) {
      const body: any = { role_id: roleId };
      if (password) body.password = password;
      try {
        const res = await fetch(`/api/admin/v2/system/users/${editingUserId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const json = (await res.json()) as any;
        (window as any).JewelryToast?.show({
          message: json.success ? "用户已更新" : json.error?.message || "更新失败",
          type: json.success ? "success" : "error",
        });
        if (json.success) {
          overlay.style.display = "none";
          loadUsers();
        }
      } catch (_e) {
        (window as any).JewelryToast?.show({ message: "网络错误", type: "error" });
      }
    } else {
      if (!password) {
        (window as any).JewelryToast?.show({ message: "密码不能为空", type: "error" });
        return;
      }
      try {
        const res = await fetch("/api/admin/v2/system/users", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password, role_id: roleId }),
        });
        const json = (await res.json()) as any;
        (window as any).JewelryToast?.show({
          message: json.success ? "用户已创建" : json.error?.message || "创建失败",
          type: json.success ? "success" : "error",
        });
        if (json.success) {
          overlay.style.display = "none";
          loadUsers();
        }
      } catch (_e) {
        (window as any).JewelryToast?.show({ message: "网络错误", type: "error" });
      }
    }
  });

  loadUsers();
</script>
