---
// Jewelry V1.0 — 订单中心（Jewelry schema + 状态机）
// 状态内部值为 PENDING_CONFIRMATION/...（见 src/lib/commerce/order.service.ts），
// 本页是唯一 UI 中文映射处；状态变更只能走合法迁移（服务端强制，409 兜底）。
import "../../../styles/admin-v2.css";
import AdminShell from "../../../components/admin/layout/AdminShell.astro";
import Sidebar from "../../../components/admin/layout/Sidebar.astro";
import Topbar from "../../../components/admin/layout/Topbar.astro";
import Toast from "../../../components/admin/shared/Toast.astro";
import Skeleton from "../../../components/admin/shared/Skeleton.astro";
---

<AdminShell title="订单中心" activeModule="commerce">
  <Sidebar slot="sidebar" activeModule="commerce" />
  <Topbar
    slot="topbar-left"
    title="订单中心"
    breadcrumbs={[{ label: "首页", href: "/admin-v2" }, { label: "商城" }, { label: "订单" }]}
  />
  <Toast />

  <div class="admin-flex-col" style="gap:var(--sp-5);">
    <div class="admin-page-header">
      <h1 class="admin-page-title">订单中心</h1>
      <p class="admin-page-desc">查看和管理所有客户订单（状态机强制合法迁移）</p>
    </div>

    <!-- KPI Bar -->
    <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--sp-3);">
      <div class="admin-kpi-card">
        <div class="admin-kpi-label">总订单</div>
        <div class="admin-kpi-value" id="kpi-total">—</div>
      </div>
      <div class="admin-kpi-card">
        <div class="admin-kpi-label">总收入（分币种）</div>
        <div class="admin-kpi-value" id="kpi-revenue" style="font-size:var(--fs-lg);">—</div>
      </div>
      <div class="admin-kpi-card">
        <div class="admin-kpi-label">平均订单</div>
        <div class="admin-kpi-value" id="kpi-avg" style="font-size:var(--fs-lg);">—</div>
      </div>
      <div class="admin-kpi-card">
        <div class="admin-kpi-label">待确认</div>
        <div class="admin-kpi-value" id="kpi-pending">—</div>
      </div>
    </section>

    <!-- Status Tabs -->
    <section class="admin-flex admin-items-center admin-justify-between" style="flex-wrap:wrap;gap:var(--sp-3);">
      <div class="admin-flex" style="gap:var(--sp-1);flex-wrap:wrap;" id="status-tabs">
        <button class="admin-tab active" data-status="">全部</button>
        <button class="admin-tab" data-status="PENDING_CONFIRMATION">待确认</button>
        <button class="admin-tab" data-status="CONFIRMED">已确认</button>
        <button class="admin-tab" data-status="PROCESSING">处理中</button>
        <button class="admin-tab" data-status="SHIPPED">已发货</button>
        <button class="admin-tab" data-status="OUT_FOR_DELIVERY">派送中</button>
        <button class="admin-tab" data-status="DELIVERED">已送达</button>
        <button class="admin-tab" data-status="CANCELLED">已取消</button>
      </div>
    </section>

    <!-- Filters -->
    <section class="admin-flex admin-items-center" style="gap:var(--sp-3);flex-wrap:wrap;">
      <input
        type="text"
        id="search-input"
        placeholder="搜索订单号/邮箱/电话..."
        class="admin-input"
        style="max-width:320px;"
      />
    </section>

    <!-- DataTable -->
    <section>
      <div class="admin-table-wrapper">
        <table class="admin-table" id="orders-table">
          <thead>
            <tr>
              <th data-sort="order_number" class="sortable">订单号</th>
              <th>客户</th>
              <th>市场</th>
              <th data-sort="total_amount" class="sortable">金额</th>
              <th data-sort="order_status" class="sortable">状态</th>
              <th data-sort="created_at" class="sortable">创建时间</th>
              <th style="width:100px;">操作</th>
            </tr>
          </thead>
          <tbody id="orders-tbody">
            <tr><td colspan="7"><Skeleton lines={5} height="32px" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="admin-flex admin-items-center admin-justify-between" style="margin-top:var(--sp-3);">
        <div id="pagination-info" class="admin-text-sm admin-text-muted"></div>
        <div class="admin-flex" style="gap:var(--sp-1);" id="pagination-controls"></div>
      </div>
    </section>

    <!-- Order Detail Drawer -->
    <div id="order-drawer-overlay" class="admin-drawer-overlay" style="display:none;"></div>
    <div id="order-drawer" class="admin-drawer" style="display:none;">
      <div class="admin-drawer-header">
        <span>订单详情</span>
        <button class="admin-btn admin-btn-ghost admin-btn-sm" id="btn-close-drawer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="admin-drawer-body" id="drawer-content"></div>
    </div>
  </div>
</AdminShell>

<script>
  const API = "/api/admin/v2/commerce/orders";
  const toast = (msg: string, type: string) => (window as any).showToast?.(msg, type);

  const STATUS_LABELS: Record<string, string> = {
    PENDING_CONFIRMATION: "待确认",
    CONFIRMED: "已确认",
    PROCESSING: "处理中",
    SHIPPED: "已发货",
    OUT_FOR_DELIVERY: "派送中",
    DELIVERED: "已送达",
    CANCELLED: "已取消",
    DELIVERY_FAILED: "派送失败",
    NDR: "问题件",
    RTO: "退回在途",
    RETURNED: "已退货",
    REFUNDED: "已退款",
  };
  const BADGE_TONE: Record<string, string> = {
    PENDING_CONFIRMATION: "admin-badge-draft",
    CONFIRMED: "admin-badge-active",
    PROCESSING: "admin-badge-active",
    SHIPPED: "admin-badge-active",
    OUT_FOR_DELIVERY: "admin-badge-active",
    DELIVERED: "admin-badge-published",
    CANCELLED: "admin-badge-archived",
    DELIVERY_FAILED: "admin-badge-archived",
    NDR: "admin-badge-draft",
    RTO: "admin-badge-draft",
    RETURNED: "admin-badge-archived",
    REFUNDED: "admin-badge-archived",
  };

  let currentStatus = "";
  let currentSearch = "";
  let currentSort = "created_at";
  let currentOrder = "desc";
  let currentPage = 1;
  const currentPageSize = 20;

  function esc(s: unknown): string {
    if (s == null) return "";
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
  function statusBadge(status: string | null): string {
    if (!status) return '<span class="admin-badge">—</span>';
    return `<span class="admin-badge ${BADGE_TONE[status] || "admin-badge"}">${esc(STATUS_LABELS[status] ?? status)}</span>`;
  }
  // minor units → 主单位
  function money(minor: number | null | undefined, currency: string): string {
    if (minor == null) return "—";
    return `${esc(currency)} ${(minor / 100).toLocaleString("en-US", { minimumFractionDigits: 2 })}`;
  }
  function fmtDate(iso: string | null | undefined): string {
    if (!iso) return "—";
    const d = new Date(iso);
    return isNaN(d.getTime()) ? "—" : d.toLocaleString("zh-CN");
  }

  async function loadOrders() {
    const params = new URLSearchParams();
    if (currentStatus) params.set("status", currentStatus);
    if (currentSearch) params.set("search", currentSearch);
    params.set("sort", currentSort);
    params.set("order", currentOrder);
    params.set("page", String(currentPage));
    params.set("pageSize", String(currentPageSize));

    try {
      const res = await fetch(`${API}?${params}`);
      if (res.status === 401) {
        window.location.href = "/admin-v2/login";
        return;
      }
      const json = (await res.json()) as any;
      if (!json.success) {
        toast("加载失败", "error");
        return;
      }
      const { data, meta } = json;
      renderTable(data || []);
      if (meta) {
        renderPagination(meta.total, meta.page, meta.totalPages);
        if (meta.kpis) {
          document.getElementById("kpi-total")!.textContent = String(meta.kpis.total_orders || 0);
          document.getElementById("kpi-revenue")!.textContent =
            meta.kpis.total_revenue > 0
              ? money(meta.kpis.total_revenue, "SAR")
              : "—";
          document.getElementById("kpi-avg")!.textContent =
            meta.kpis.avg_order_value > 0
              ? money(meta.kpis.avg_order_value, "SAR")
              : "—";
        }
        document.getElementById("kpi-pending")!.textContent = String(
          meta.statusCounts?.PENDING_CONFIRMATION || 0,
        );
      }
    } catch {
      toast("网络错误", "error");
    }
  }

  function renderTable(orders: any[]) {
    const tbody = document.getElementById("orders-tbody")!;
    if (!orders.length) {
      tbody.innerHTML =
        '<tr><td colspan="7" class="admin-empty"><div class="admin-empty-title">暂无订单</div></td></tr>';
      return;
    }
    tbody.innerHTML = orders
      .map(
        (o) => `
      <tr data-id="${esc(o.id)}">
        <td class="admin-font-semibold">${esc(o.order_number)}</td>
        <td>${esc([o.first_name, o.last_name].filter(Boolean).join(" ") || o.customer_email || "访客")}</td>
        <td>${esc(o.market || "—")}</td>
        <td class="admin-font-semibold text-nowrap">${money(o.total_amount, o.currency)}</td>
        <td>${statusBadge(o.order_status)}</td>
        <td class="admin-text-muted text-nowrap">${fmtDate(o.created_at)}</td>
        <td><button class="admin-btn admin-btn-secondary admin-btn-sm btn-detail" data-id="${esc(o.id)}">详情</button></td>
      </tr>
    `,
      )
      .join("");
    tbody
      .querySelectorAll(".btn-detail")
      .forEach((b) => b.addEventListener("click", () => openDrawer((b as HTMLElement).dataset.id!)));
  }

  function renderPagination(total: number, page: number, totalPages: number) {
    const info = document.getElementById("pagination-info");
    const controls = document.getElementById("pagination-controls");
    if (info) info.textContent = `共 ${total} 条，第 ${page}/${totalPages || 1} 页`;
    if (!controls) return;
    let html = "";
    if (page > 1)
      html += `<button class="admin-btn admin-btn-secondary admin-btn-sm" data-p="${page - 1}">上一页</button>`;
    if (page < totalPages)
      html += `<button class="admin-btn admin-btn-secondary admin-btn-sm" data-p="${page + 1}">下一页</button>`;
    controls.innerHTML = html;
    controls.querySelectorAll("button").forEach((b) =>
      b.addEventListener("click", () => {
        currentPage = Number((b as HTMLElement).dataset.p);
        loadOrders();
      }),
    );
  }

  function closeDrawer() {
    document.getElementById("order-drawer")!.style.display = "none";
    document.getElementById("order-drawer-overlay")!.style.display = "none";
  }

  async function openDrawer(id: string) {
    try {
      const res = await fetch(`${API}?id=${id}`);
      const json = (await res.json()) as any;
      if (!json.success) {
        toast("加载失败", "error");
        return;
      }
      const { order, items, events, address, legalTransitions } = json.data;
      const drawer = document.getElementById("order-drawer")!;
      const overlay = document.getElementById("order-drawer-overlay")!;
      const content = document.getElementById("drawer-content")!;
      drawer.style.display = "flex";
      overlay.style.display = "block";
      const cur = order.order_status as string;

      content.innerHTML = `
        <div class="admin-flex-col" style="gap:var(--sp-4);">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);">
            <div class="admin-form-group"><span class="admin-label">订单号</span><div class="admin-font-semibold">${esc(order.order_number)}</div></div>
            <div class="admin-form-group"><span class="admin-label">状态</span><div>${statusBadge(cur)}</div></div>
            <div class="admin-form-group"><span class="admin-label">市场 / 币种</span><div>${esc(order.market || "—")} / ${esc(order.currency || "—")}</div></div>
            <div class="admin-form-group"><span class="admin-label">支付</span><div>${esc(order.payment_status || "—")}</div></div>
            <div class="admin-form-group"><span class="admin-label">客户</span><div>${esc(address ? [address.first_name, address.last_name].filter(Boolean).join(" ") : "") || "访客"}</div></div>
            <div class="admin-form-group"><span class="admin-label">电话</span><div>${esc(address?.phone || "—")}</div></div>
            <div class="admin-form-group" style="grid-column:1/-1;"><span class="admin-label">地址</span><div>${esc([address?.address_line_1, address?.district, address?.city, address?.region, address?.country].filter(Boolean).join(", ") || "—")}</div></div>
          </div>
          <hr class="admin-divider" />
          <div>
            <div class="admin-flex admin-justify-between" style="margin-bottom:var(--sp-1);"><span class="admin-text-muted">小计</span><span>${money(order.subtotal, order.currency)}</span></div>
            ${order.discount_amount > 0 ? `<div class="admin-flex admin-justify-between" style="margin-bottom:var(--sp-1);"><span class="admin-text-muted">折扣${order.discount_code ? ` (${esc(order.discount_code)})` : ""}</span><span>- ${money(order.discount_amount, order.currency)}</span></div>` : ""}
            <div class="admin-flex admin-justify-between" style="margin-bottom:var(--sp-1);"><span class="admin-text-muted">运费</span><span>${money(order.shipping_amount, order.currency)}</span></div>
            <div class="admin-flex admin-justify-between" style="margin-bottom:var(--sp-1);"><span class="admin-text-muted">税费</span><span>${money(order.tax_amount, order.currency)}</span></div>
            <div class="admin-flex admin-justify-between admin-font-bold" style="font-size:var(--fs-lg);"><span>总计</span><span>${money(order.total_amount, order.currency)}</span></div>
          </div>
          ${items.length ? `<div><hr class="admin-divider" /><h4 class="admin-section-title">商品 (${items.length})</h4>${items.map((it: any) => `<div class="admin-flex admin-justify-between" style="padding:var(--sp-2) 0;border-bottom:1px solid var(--line);font-size:var(--fs-base);"><span>${esc(it.title)}${it.sku ? ` <span class="admin-text-muted">(${esc(it.sku)})</span>` : ""} × ${it.quantity}</span><span>${money(it.line_total, order.currency)}</span></div>`).join("")}</div>` : ""}
          ${events.length ? `<div><hr class="admin-divider" /><h4 class="admin-section-title">时间线</h4>${events.map((ev: any) => `<div class="admin-flex" style="gap:var(--sp-2);padding:var(--sp-2) 0;font-size:var(--fs-base);"><span class="admin-text-muted" style="white-space:nowrap;">${fmtDate(ev.created_at)}</span><span>${esc(ev.description || STATUS_LABELS[ev.status] || ev.status)}</span></div>`).join("")}</div>` : ""}
          <hr class="admin-divider" />
          <div>
            <h4 class="admin-section-title">状态迁移（仅合法路径）</h4>
            ${legalTransitions.length ? `
            <div class="admin-flex" style="gap:var(--sp-2);">
              <select id="drawer-status" class="admin-select" style="flex:1;">
                <option value="" selected disabled>选择目标状态…</option>
                ${legalTransitions.map((s: string) => `<option value="${s}">${esc(STATUS_LABELS[s] ?? s)}</option>`).join("")}
              </select>
              <button class="admin-btn admin-btn-primary" id="btn-update-status">迁移</button>
            </div>
            <input id="drawer-reason" class="admin-input" style="width:100%;margin-top:var(--sp-2);" placeholder="备注（可选）" />
            ` : '<div class="admin-text-muted admin-text-sm">该状态为终态，无可用迁移。</div>'}
          </div>
        </div>
      `;

      document.getElementById("btn-update-status")?.addEventListener("click", async () => {
        const sel = document.getElementById("drawer-status") as unknown as HTMLSelectElement;
        const newStatus = sel?.value;
        if (!newStatus) {
          toast("请选择目标状态", "warning");
          return;
        }
        const reason = (document.getElementById("drawer-reason") as unknown as HTMLInputElement)?.value?.trim();
        try {
          const res = await fetch(API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, status: newStatus, reason }),
          });
          const j = (await res.json()) as any;
          if (j.success) {
            toast("已迁移", "success");
            closeDrawer();
            loadOrders();
          } else {
            toast(j.error?.message || "迁移失败", "error");
          }
        } catch {
          toast("网络错误", "error");
        }
      });
    } catch {
      toast("网络错误", "error");
    }
  }

  document.getElementById("btn-close-drawer")?.addEventListener("click", closeDrawer);
  document.getElementById("order-drawer-overlay")?.addEventListener("click", closeDrawer);

  document.getElementById("status-tabs")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    if (!btn) return;
    document.querySelectorAll("#status-tabs .admin-tab").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    currentStatus = btn.dataset.status || "";
    currentPage = 1;
    loadOrders();
  });

  let searchTimer: ReturnType<typeof setTimeout>;
  document.getElementById("search-input")?.addEventListener("input", (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      currentSearch = (e.target as HTMLInputElement).value.trim();
      currentPage = 1;
      loadOrders();
    }, 300);
  });

  document.querySelectorAll(".sortable").forEach((th) => {
    th.addEventListener("click", () => {
      const col = (th as HTMLElement).dataset.sort!;
      if (currentSort === col) currentOrder = currentOrder === "desc" ? "asc" : "desc";
      else {
        currentSort = col;
        currentOrder = "desc";
      }
      loadOrders();
    });
  });

  loadOrders();
</script>
