---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCommerce, calcOrderTotals } from "../../../lib/commerce";
import type { Market } from "../../../lib/commerce";
import { t } from "../../../i18n";
import { requireLocale } from "../../../lib/locale";

const { lang } = Astro.params;
const _locale = requireLocale(lang);
if (_locale instanceof Response) return _locale;
const locale = _locale;

const db = Astro.locals.runtime.env.DB;
if (!db) return new Response("Database unavailable", { status: 503 });

// Feature flag from site_settings (config, not hardcoded UI state)
const flagRow = await db
  .prepare(`SELECT value FROM site_settings WHERE key = 'feature.enable_online_payment'`)
  .first<{ value: string }>();
const ENABLE_ONLINE_PAYMENT = flagRow?.value === "true";

const sessionId = Astro.cookies.get("session_id")?.value;
const commerce = getCommerce(db, { enableOnlinePayment: ENABLE_ONLINE_PAYMENT });

// ---- Load cart ----
let cartData = null;
if (sessionId) {
  cartData = await commerce.cart.getCartBySessionId(sessionId);
}

let error: string | null = null;
let orderId: string | null = null;

// ---- POST: server-side transaction entry -----------------------------------
//
// Order of operations matters (P0-3):
//   1. re-read every variant  → price & stock truth come from D1, never the client
//   2. claim the cart         → single-use guard against double submit
//   3. reserve stock          → conditional UPDATE (all-or-nothing, compensating)
//   4. create the order       → any later failure releases both 2 and 3
if (Astro.request.method === "POST") {
  if (!cartData || cartData.items.length === 0) {
    error = "cart_empty";
  } else {
    const formData = await Astro.request.formData();
    const first = String(formData.get("first_name") || "")
      .trim()
      .slice(0, 100);
    const last = String(formData.get("last_name") || "")
      .trim()
      .slice(0, 100);
    const email = String(formData.get("email") || "")
      .trim()
      .slice(0, 200)
      .toLowerCase();
    const phone = String(formData.get("phone") || "")
      .trim()
      .slice(0, 50);
    const country = String(formData.get("country") || "").trim();
    const city = String(formData.get("city") || "")
      .trim()
      .slice(0, 100);
    const address1 = String(formData.get("address") || "")
      .trim()
      .slice(0, 500);
    const paymentMethod = String(formData.get("payment_method") || "cod");

    // Validation
    if (!first || !last) error = "name_required";
    else if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) error = "email_invalid";
    else if (!phone) error = "phone_required";
    else if (!city || !address1) error = "address_required";
    else if (paymentMethod !== "cod") error = "payment_unavailable";
    else {
      // Market resolution (config-driven tax/shipping)
      const marketCode = country === "UAE" ? "UAE" : "KSA";
      const market = await db
        .prepare(`SELECT * FROM markets WHERE code = ? AND is_active = 1`)
        .bind(marketCode)
        .first<Market>();

      if (!market) {
        error = "market_unavailable";
      } else {
        // ---- Step 1: server recalculation (client prices are NEVER trusted) ----
        const lines: Array<{ unit_price: number; quantity: number }> = [];
        const orderItems: Array<{
          product_id: string;
          variant_id: string;
          sku: string | null;
          title: string;
          unit_price: number;
          quantity: number;
          product_snapshot: unknown;
        }> = [];

        for (const item of cartData.items) {
          const fresh = await db
            .prepare(
              `
            SELECT v.id, v.sku, v.price, v.inventory_quantity, v.inventory_policy, v.status AS v_status, p.title, p.status AS p_status
            FROM product_variants v JOIN products p ON p.id = v.product_id
            WHERE v.id = ? AND v.product_id = ?
          `,
            )
            .bind(item.variant_id, item.product_id)
            .first<{
              id: string;
              sku: string | null;
              price: number;
              inventory_quantity: number;
              inventory_policy: string;
              v_status: string;
              title: string;
              p_status: string;
            }>();

          if (!fresh) {
            error = "item_unavailable";
            break;
          }
          if (fresh.p_status !== "active" || fresh.v_status !== "active") {
            error = "item_unavailable";
            break;
          }
          if (fresh.inventory_policy === "deny" && fresh.inventory_quantity < item.quantity) {
            error = "out_of_stock";
            break;
          }

          lines.push({ unit_price: fresh.price, quantity: item.quantity });
          orderItems.push({
            product_id: item.product_id,
            variant_id: item.variant_id,
            sku: fresh.sku,
            title: fresh.title,
            unit_price: fresh.price,
            quantity: item.quantity,
            product_snapshot: { title: fresh.title, sku: fresh.sku },
          });
        }

        if (!error) {
          const cartId = cartData.cart.id;

          // ---- Step 2: claim the cart (duplicate-submit guard) ----
          const claimed = await commerce.inventory.claimCart(cartId);
          if (!claimed) {
            error = "duplicate_submission";
          } else {
            // ---- Step 3: reserve stock atomically (all-or-nothing) ----
            const reservation = await commerce.inventory.reserve(
              orderItems.map((i) => ({ variant_id: i.variant_id, quantity: i.quantity })),
            );

            if (!reservation.ok) {
              await commerce.inventory.releaseCart(cartId);
              error = "out_of_stock";
            } else {
              // Tax & shipping come from market config — never hardcoded in the page
              const totals = calcOrderTotals(lines, market);
              const customer = await commerce.customers.findOrCreateGuest({
                email,
                phone,
                first_name: first,
                last_name: last,
                locale: lang ?? "en",
                market: market.code,
              });

              // ---- Step 4: create the order (compensate 2 + 3 on failure) ----
              let order = null;
              try {
                order = await commerce.orders.createOrder({
                  customer_id: customer.id,
                  session_id: sessionId,
                  market: market.code,
                  currency: market.currency,
                  subtotal: totals.subtotal,
                  discount_amount: totals.discount,
                  shipping_amount: totals.shipping,
                  tax_amount: totals.tax,
                  items: orderItems,
                  shipping_address: {
                    first_name: first,
                    last_name: last,
                    phone,
                    country: market.code,
                    city,
                    address_line_1: address1,
                  },
                });

                // Payment (V1: COD only)
                if (paymentMethod === "cod") {
                  await commerce.cod.createCheckout(order);
                }
              } catch (err) {
                console.error("[checkout] order creation failed — compensating", err);
                await commerce.inventory.release(reservation.reserved);
                await commerce.inventory.releaseCart(cartId);
              }

              if (!order) {
                error = "unknown";
              } else {
                // Order + stock + payment are settled; retire the cart.
                await commerce.cart.clearCart(cartId);
                Astro.cookies.delete("session_id", { path: "/" });

                orderId = order.id;
                return Astro.redirect(`/${lang}/order-confirmation?id=${order.id}`);
              }
            }
          }
        }
      }
    }
  }
}

// ---- GET rendering ----
const items = cartData?.items ?? [];
const hasStockIssues = items.some(
  (i) => i.variant.status !== "active" || i.variant.inventory_quantity < i.quantity,
);

// Preview totals server-side (market defaults to KSA until the form selects one)
const previewMarket = await db.prepare(`SELECT * FROM markets WHERE code = 'KSA'`).first<Market>();
const previewTotals = previewMarket
  ? calcOrderTotals(
      items.map((i) => ({ unit_price: i.variant.price, quantity: i.quantity })),
      previewMarket,
    )
  : null;
const previewCurrency = items[0]?.variant.currency ?? "SAR";

const formatMoney = (price: number) =>
  new Intl.NumberFormat(locale, { style: "currency", currency: previewCurrency }).format(
    price / 100,
  );

const errKey = error ? `checkout.error_${error}` : "";
---

<BaseLayout
  locale={locale}
  title={t(locale, "checkout.title")}
  description={t(locale, "checkout.title")}
>
  <main class="container-x py-12">
    <h1 class="text-3xl font-bold mb-8">{t(locale, "checkout.title")}</h1>

    {
      error && (
        <div class="mb-6 border border-red-300 bg-red-50 text-red-700 rounded-lg p-4 text-sm">
          {t(locale, errKey) !== errKey ? t(locale, errKey) : error}
        </div>
      )
    }

    {
      items.length === 0 ? (
        <div class="text-center py-16 border border-dashed border-line rounded-xl">
          <p class="text-stone">{t(locale, "cart.empty")}</p>
          <a href={`/${lang}/`} class="btn btn-primary mt-4 inline-block">
            {t(locale, "cart.continue")}
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
          <form method="POST" id="checkout-form" class="space-y-8">
            <section>
              <h2 class="text-xl font-semibold mb-4">{t(locale, "checkout.contact_section")}</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                <input
                  type="text"
                  name="first_name"
                  placeholder={t(locale, "checkout.first_name")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full"
                />
                <input
                  type="text"
                  name="last_name"
                  placeholder={t(locale, "checkout.last_name")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full"
                />
                <input
                  type="email"
                  name="email"
                  placeholder={t(locale, "checkout.email")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full sm:col-span-2"
                />
                <input
                  type="tel"
                  name="phone"
                  placeholder={t(locale, "checkout.phone")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full sm:col-span-2"
                />
              </div>
            </section>

            <section>
              <h2 class="text-xl font-semibold mb-4">{t(locale, "checkout.address_section")}</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                <select
                  name="country"
                  id="co-country"
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full sm:col-span-2"
                >
                  <option value="KSA">{t(locale, "checkout.country_ksa")}</option>
                  <option value="UAE">{t(locale, "checkout.country_uae")}</option>
                </select>
                <input
                  type="text"
                  name="city"
                  placeholder={t(locale, "checkout.city")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full sm:col-span-2"
                />
                <input
                  type="text"
                  name="address"
                  placeholder={t(locale, "checkout.address")}
                  required
                  class="border border-line rounded-lg px-4 py-2 w-full sm:col-span-2"
                />
              </div>
            </section>

            <section>
              <h2 class="text-xl font-semibold mb-4">{t(locale, "checkout.payment_section")}</h2>
              <div class="space-y-3">
                <label class="flex items-center gap-3 border border-line rounded-lg p-4 cursor-pointer">
                  <input
                    type="radio"
                    name="payment_method"
                    value="cod"
                    required
                    checked
                    class="w-4 h-4 text-accent"
                  />
                  <span class="font-medium">{t(locale, "checkout.cod")}</span>
                </label>
                {ENABLE_ONLINE_PAYMENT && (
                  <label class="flex items-center gap-3 border border-line rounded-lg p-4 opacity-50 cursor-not-allowed">
                    <input
                      type="radio"
                      name="payment_method"
                      value="online"
                      disabled
                      class="w-4 h-4"
                    />
                    <span class="font-medium">{t(locale, "checkout.online")}</span>
                  </label>
                )}
              </div>
            </section>

            {hasStockIssues && (
              <p class="text-sm text-red-600">{t(locale, "checkout.stock_warning")}</p>
            )}

            <button
              type="submit"
              class="btn btn-primary w-full py-4 text-lg"
              disabled={hasStockIssues}
            >
              {t(locale, "checkout.place_order")}
            </button>
          </form>

          <div>
            <div class="border border-line rounded-xl p-6 bg-beige/30 sticky top-6">
              <h2 class="text-xl font-semibold mb-4">{t(locale, "checkout.summary")}</h2>
              <div class="space-y-4 mb-4">
                {items.map((item) => (
                  <div class="flex justify-between items-center text-sm">
                    <div class="flex gap-3 items-center">
                      <span class="w-6 h-6 bg-stone/20 rounded-full flex items-center justify-center text-xs">
                        {item.quantity}
                      </span>
                      <span class="font-medium">{item.product.title}</span>
                    </div>
                    <span>{formatMoney(item.variant.price * item.quantity)}</span>
                  </div>
                ))}
              </div>
              {previewTotals && (
                <dl class="space-y-2 text-sm border-t border-line pt-4">
                  <div class="flex justify-between">
                    <dt>{t(locale, "checkout.subtotal")}</dt>
                    <dd>{formatMoney(previewTotals.subtotal)}</dd>
                  </div>
                  <div class="flex justify-between">
                    <dt>{t(locale, "checkout.shipping")}</dt>
                    <dd>
                      {previewTotals.shipping === 0
                        ? t(locale, "checkout.free")
                        : formatMoney(previewTotals.shipping)}
                    </dd>
                  </div>
                  <div class="flex justify-between">
                    <dt>{t(locale, "checkout.vat")}</dt>
                    <dd>{formatMoney(previewTotals.tax)}</dd>
                  </div>
                  <div class="flex justify-between text-lg font-bold border-t border-line pt-2 mt-2">
                    <dt>{t(locale, "checkout.total")}</dt>
                    <dd>{formatMoney(previewTotals.total)}</dd>
                  </div>
                </dl>
              )}
              <p class="mt-4 text-xs text-stone" id="co-note">
                {t(locale, "checkout.totals_note")}
              </p>
            </div>
          </div>
        </div>
      )
    }
  </main>
</BaseLayout>
