---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n";
import { requireLocale } from "../../lib/locale";
import { getCommerce } from "../../lib/commerce";

const { lang } = Astro.params;
const _locale = requireLocale(lang);
if (_locale instanceof Response) return _locale;
const locale = _locale;
const orderId = Astro.url.searchParams.get("id");

if (!orderId) return Astro.redirect(`/${lang}/`);

const db = Astro.locals.runtime.env.DB;
const commerce = getCommerce(db);
const order = await commerce.orders.getOrder(orderId);

if (!order) return Astro.redirect(`/${lang}/`);

const formattedPrice = (price: number) => {
  return new Intl.NumberFormat(locale, { style: 'currency', currency: order.currency }).format(price / 100);
};

// Internal order status → localized label (never show the raw enum to a buyer).
const statusLabel = t(locale, `order.status_label.${order.order_status}`);

---
<BaseLayout locale={locale} title={t(locale, "order.confirmed_title")} description={t(locale, "order.confirmed_title")}>
  <main class="container-x py-16 text-center max-w-2xl mx-auto">
    <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h1 class="text-3xl font-bold mb-2">{t(locale, "order.confirmed_title")}</h1>
    <p class="text-stone text-lg">{t(locale, "order.thanks")}</p>

    <div class="mt-10 border border-line rounded-xl p-6 text-left bg-surface">
      <h2 class="font-semibold text-lg border-b border-line pb-3 mb-3">{t(locale, "order.details")}</h2>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-stone">{t(locale, "order.number")}</p>
          <p class="font-medium mt-1">{order.order_number}</p>
        </div>
        <div>
          <p class="text-stone">{t(locale, "order.total")}</p>
          <p class="font-medium mt-1">{formattedPrice(order.total_amount)}</p>
        </div>
        <div>
          <p class="text-stone">{t(locale, "order.payment_method")}</p>
          <p class="font-medium mt-1">{t(locale, "checkout.cod")}</p>
        </div>
        <div>
          <p class="text-stone">{t(locale, "order.status")}</p>
          <p class="font-medium mt-1">{statusLabel}</p>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <a href={`/${lang}/`} class="btn btn-primary px-8">{t(locale, "order.continue")}</a>
    </div>
  </main>
</BaseLayout>
