    // V5.324: allowlist HTML sanitizer — AI batch descriptions are HTML (<p>…);
    // keep only safe structural tags, strip ALL attributes, escape text.
    function safeHtml(html) {
      const ALLOWED = { P: 1, BR: 1, UL: 1, OL: 1, LI: 1, STRONG: 1, EM: 1, B: 1, I: 1 };
      const DROP_WITH_CONTENT = {
        SCRIPT: 1,
        STYLE: 1,
        HEAD: 1,
        TITLE: 1,
        NOSCRIPT: 1,
        IFRAME: 1,
        OBJECT: 1,
        EMBED: 1,
        LINK: 1,
        META: 1,
      };
      const doc = new DOMParser().parseFromString(html, "text/html");
      function clean(node) {
        let out = "";
        for (let c = node.firstChild; c; c = c.nextSibling) {
          if (c.nodeType === 3) {
            out += esc(c.nodeValue);
          } else if (c.nodeType === 1) {
            if (DROP_WITH_CONTENT[c.nodeName]) continue;
            const tag = c.nodeName.toLowerCase();
            if (ALLOWED[c.nodeName]) {
              out += "<" + tag + ">" + clean(c) + "</" + tag + ">";
            } else {
              out += clean(c); // unwrap disallowed tags, keep their text
            }
          }
        }
        return out;
      }
      return clean(doc.body);
    }

    function renderDescription(p) {
      const section = document.getElementById("pdp-description-section");
      const el = document.getElementById("pdp-description");
      const desc = p.description || p.short_description || "";
      if (!desc.trim()) {
        // No description in source data — hide the whole section (no placeholders)
        if (section) section.classList.add("hidden");
        return;
      }
      // AI-generated descriptions are HTML; render through the allowlist sanitizer.
      if (/<(p|br|ul|ol|li|strong|em|b|i)\b/i.test(desc)) {
        el.innerHTML = safeHtml(desc);
        return;
      }
      // Convert newlines to paragraphs
      const paragraphs = desc.split(/\n\n+/);
      let html = "";
      for (let i = 0; i < paragraphs.length; i++) {
        const text = paragraphs[i].trim();
        if (!text) continue;
        html += "<p>" + esc(text).replace(/\n/g, "<br/>") + "</p>";
      }
      el.innerHTML = html;
    }

    function renderPackaging(p) {
      const packList = document.getElementById("pdp-packaging-list");
      const packItems = (p.packaging_options || []).filter(function (o) {
        return o && String(o).trim();
      });
      if (packItems.length) {
        let html = "";
        for (let i = 0; i < packItems.length; i++) {
          html +=
            '<li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg><span>' +
            esc(String(packItems[i])) +
            "</span></li>";
        }
        packList.innerHTML = html;
      } else {
        packList.innerHTML =
          '<li class="text-stone">Packaging details to be confirmed — contact us for export packing options.</li>';
      }

      // OEM block only when the product really supports it
      const oemBlock = document.getElementById("pdp-oem-packaging");
      if (oemBlock && p.oem_available) {
        oemBlock.classList.remove("hidden");
      }
    }

    function populateShippingPackaging(p, variants) {
      // Use first variant with dimensions, fallback to product-level parcel data
      let ref = null;
      for (let vi = 0; vi < variants.length; vi++) {
        if (variants[vi].length_cm || variants[vi].weight_kg) {
          ref = variants[vi];
          break;
        }
      }
      if (
        !ref &&
        (p.carton_length_cm ||
          p.carton_width_cm ||
          p.carton_height_cm ||
          p.carton_weight_kg ||
          p.weight)
      ) {
        ref = {
          length_cm: p.carton_length_cm,
          width_cm: p.carton_width_cm,
          height_cm: p.carton_height_cm,
          weight_kg: p.carton_weight_kg || p.weight,
        };
      }

      const sizeEl = document.getElementById("pdp-product-size");
      if (ref && (ref.length_cm || ref.width_cm || ref.height_cm)) {
        sizeEl.textContent =
          (ref.length_cm || "?") +
          " × " +
          (ref.width_cm || "?") +
          " × " +
          (ref.height_cm || "?") +
          " cm";
      } else {
        sizeEl.textContent = "To be confirmed";
      }

      const weightEl = document.getElementById("pdp-unit-weight");
      if (ref && ref.weight_kg) {
        weightEl.textContent = ref.weight_kg + " kg";
      } else {
        weightEl.textContent = "To be confirmed";
      }

      const pcsPerCarton = parseInt(p.units_per_carton) || 0;
      const cartonEl = document.getElementById("pdp-pcs-carton");
      cartonEl.textContent = pcsPerCarton > 0 ? pcsPerCarton + " pcs" : "To be confirmed";

      // Carton volume: only show when real carton data exists (per V2.1 doc — no guessing)
      const cartonVolEl = document.getElementById("pdp-carton-volume");
      cartonVolEl.textContent = "To be confirmed";

      // Shipping estimator
      const estBtn = document.getElementById("pdp-estimator-btn");
      const estInput = document.getElementById("pdp-estimator-qty");
      if (estBtn && estInput) {
        estBtn.addEventListener("click", function () {
          const qty = parseInt(estInput.value) || 0;
          if (qty < 1) return;
          let unitWeight = 0;
          for (let i = 0; i < variants.length; i++) {
            if (variants[i].weight_kg) {
              unitWeight = parseFloat(variants[i].weight_kg) || 0;
              break;
            }
          }
          if (!unitWeight) {
            unitWeight = parseFloat(p.carton_weight_kg || p.weight) || 0;
          }

          const resultEl = document.getElementById("pdp-estimator-result");
          resultEl.classList.remove("hidden");

          document.getElementById("pdp-est-cartons").textContent =
            pcsPerCarton > 0
              ? "≈ " + Math.ceil(qty / pcsPerCarton) + " carton(s)"
              : "To be confirmed";

          document.getElementById("pdp-est-weight").textContent =
            unitWeight > 0 ? "≈ " + (unitWeight * qty).toFixed(1) + " kg" : "To be confirmed";

          const volEl = document.getElementById("pdp-est-volume");
          if (ref && ref.length_cm && ref.width_cm && ref.height_cm) {
            const volCbm =
              ((parseFloat(ref.length_cm) * parseFloat(ref.width_cm) * parseFloat(ref.height_cm)) /
                1000000) *
              qty;
            volEl.textContent = "≈ " + volCbm.toFixed(3) + " m\u00B3";
          } else {
            volEl.textContent = "To be confirmed";
          }

          // Shipping quote link
          const quoteLink = document.getElementById("pdp-shipping-quote-link");
          if (quoteLink) {
            quoteLink.href =
              contactHref +
              "?subject=shipping-quote&product=" +
              encodeURIComponent(p.slug) +
              "&qty=" +
              qty;
          }
        });
      }
    }

    function renderFaq(p) {
      // Doc §24: real DB FAQ entries first; built-in questions only when backed
      // by real fields. No fabricated lead times, certifications, or terms.
      const faqs = [];

      const dbFaqs = Array.isArray(p.faq) ? p.faq : [];
      for (let i = 0; i < dbFaqs.length; i++) {
        const q = dbFaqs[i] && (dbFaqs[i].q || dbFaqs[i].question);
        const a = dbFaqs[i] && (dbFaqs[i].a || dbFaqs[i].answer);
        if (q && a) faqs.push({ q: String(q), a: String(a) });
      }

      faqs.push({
        q: "What is the minimum order quantity (MOQ)?",
        a:
          "The MOQ for this product is " +
          (p.moq || 1) +
          " " +
          (p.unit || "pieces") +
          ". Contact us if you need a different quantity.",
      });

      if (p.sample_available) {
        faqs.push({
          q: "Can I get a sample before placing a bulk order?",
          a: "Yes. Samples of this product are available — use the Request Sample button or contact us to arrange one.",
        });
      }

      if (p.oem_available) {
        faqs.push({
          q: "Do you support OEM / private label for this product?",
          a: "Yes. This product supports OEM/ODM customization. Contact us to discuss branding, fragrance, and packaging options for your order.",
        });
      }

      if (p.certifications && p.certifications.length) {
        faqs.push({
          q: "What certifications does this product have?",
          a: "This product is listed with: " + p.certifications.join(", ") + ".",
        });
      }

      if (p.packaging_options && p.packaging_options.length) {
        faqs.push({
          q: "What packaging options are available?",
          a: "Available packaging includes: " + p.packaging_options.join(", ") + ".",
        });
      }

      faqs.push({
        q: "How do I get a shipping quote?",
        a: "Shipping cost depends on quantity, destination, and shipping method. Use the Shipping Quote button above or contact us with your destination and quantity, and we will reply with options.",
      });

      const el = document.getElementById("pdp-faq");
      pdpFaqs = faqs;
      el.innerHTML = "";
      for (let i = 0; i < faqs.length; i++) {
        const faqId = "pdp-faq-" + i;
        el.innerHTML +=
          '<div class="overflow-hidden rounded-xl border border-line bg-card">' +
          '<button class="faq-toggle flex w-full items-center justify-between px-5 py-4 text-left text-sm font-medium transition-colors hover:bg-beige/50" data-target="' +
          faqId +
          '" aria-expanded="false">' +
          "<span>" +
          esc(faqs[i].q) +
          "</span>" +
          '<svg class="faq-chevron h-5 w-5 shrink-0 text-stone transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>' +
          "</button>" +
          '<div id="' +
          faqId +
          '" class="faq-body hidden px-5 pb-4">' +
          '<p class="text-sm leading-relaxed text-stone">' +
          esc(faqs[i].a) +
          "</p>" +
          "</div></div>";
      }

      // Bind accordion
      const toggles = el.querySelectorAll(".faq-toggle");
      for (let t = 0; t < toggles.length; t++) {
        toggles[t].addEventListener("click", function () {
          const target = document.getElementById(this.getAttribute("data-target"));
          const chevron = this.querySelector(".faq-chevron");
          const isOpen = !target.classList.contains("hidden");
          if (isOpen) {
            target.classList.add("hidden");
            chevron.style.transform = "rotate(0deg)";
            this.setAttribute("aria-expanded", "false");
          } else {
            target.classList.remove("hidden");
            chevron.style.transform = "rotate(180deg)";
            this.setAttribute("aria-expanded", "true");
          }
        });
      }
    }

    function renderRelated(p) {
      // CROSS_SELL mapping for "Complete Your Product Line"
      const CROSS_SELL = {
        "reed-diffuser": ["fragrance-oil", "packaging", "candle"],
        "essential-oil": ["reed-diffuser", "candle", "packaging"],
        candle: ["fragrance-oil", "packaging", "reed-diffuser"],
        "home-fragrance": ["reed-diffuser", "candle", "essential-oil"],
        "car-fragrance": ["home-fragrance", "packaging"],
        "fragrance-oil": ["reed-diffuser", "candle", "packaging"],
        packaging: ["reed-diffuser", "candle", "essential-oil"],
      };

      function productCardHtml(rp) {
        const price =
          rp.price_tiers && rp.price_tiers.length
            ? formatPrice(rp.price_tiers[0].unit_price, rp.price_tiers[0].currency)
            : rp.price_from
              ? "$" + Number(rp.price_from).toFixed(2)
              : "";
        return (
          '<a href="' +
          shopHref +
          "/" +
          esc(rp.slug) +
          '" class="group card-surface w-64 shrink-0 snap-start overflow-hidden rounded-xl transition-all hover:-translate-y-1 hover:shadow-lg">' +
          '<div class="aspect-[4/3] overflow-hidden bg-beige">' +
          (rp.cover_image
            ? '<img src="' +
              esc(rp.cover_image) +
              '" alt="' +
              esc(rp.title) +
              '" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />'
            : '<div class="flex h-full items-center justify-center text-stone/30"><svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125l2.25 2.25m0 0l2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25" /></svg></div>') +
          "</div>" +
          '<div class="p-4">' +
          '<h3 class="line-clamp-2 text-sm font-medium leading-snug">' +
          esc(displayName(rp)) +
          "</h3>" +
          '<div class="mt-2 flex items-center justify-between text-xs text-stone">' +
          (price ? '<span class="font-semibold text-ink">' + price + "</span>" : "<span></span>") +
          "<span>MOQ: " +
          (rp.moq || 1) +
          "</span>" +
          "</div></div></a>"
        );
      }

      // Group 1: Similar Products (same category, exclude current)
      // V5.69 Canonical: related also uses the same Ready-to-Ship eligibility (rts=1), sharing with Shop / Downloads
      // Catalog / Preview one product set; no separate pool.
      if (p.category) {
        fetch(API + "?category=" + encodeURIComponent(p.category) + "&rts=1")
          .then(function (res) {
            return res.json();
          })
          .then(function (data) {
            const products = data.products || [];
            const related = [];
            for (let i = 0; i < products.length && related.length < 4; i++) {
              if (products[i].slug !== p.slug) related.push(products[i]);
            }
            if (!related.length) return;
            const el = document.getElementById("pdp-related");
            let html = "";
            for (let j = 0; j < related.length; j++) {
              html += productCardHtml(related[j]);
            }
            el.innerHTML = html;
            document.getElementById("pdp-similar-group").classList.remove("hidden");
          })
          .catch(function () {});
      }

      // Group 2: Complete Your Product Line (cross-category)
      const crossCats = CROSS_SELL[p.category] || [];
      if (crossCats.length) {
        const crossPromises = [];
        for (let c = 0; c < crossCats.length; c++) {
          crossPromises.push(
            fetch(API + "?category=" + encodeURIComponent(crossCats[c]))
              .then(function (res) {
                return res.json();
              })
              .catch(function () {
                return { products: [] };
              }),
          );
        }
        Promise.all(crossPromises).then(function (results) {
          const crossProducts = [];
          for (let r = 0; r < results.length; r++) {
            const prods = results[r].products || [];
            for (let k = 0; k < prods.length && crossProducts.length < 3; k++) {
              if (prods[k].slug !== p.slug) {
                crossProducts.push(prods[k]);
              }
            }
            if (crossProducts.length >= 3) break;
          }
          if (!crossProducts.length) return;
          const el = document.getElementById("pdp-crosssell");
          let html = "";
          for (let j = 0; j < crossProducts.length; j++) {
            html += productCardHtml(crossProducts[j]);
          }
          el.innerHTML = html;
          document.getElementById("pdp-crosssell-group").classList.remove("hidden");
        });
      }
    }

    // ---- Content Interlink: Related Guides ----
    function renderGuides(p) {
      if (!p.category) return;
      fetch("/search-index.json")
        .then(function (res) {
          return res.json();
        })
        .then(function (entries) {
          if (!entries || !entries.length) return;
          const catParts = p.category.split("-");
          const matched = [];
          for (let i = 0; i < entries.length && matched.length < 3; i++) {
            const entry = entries[i];
            if (entry.type !== "guide" && entry.type !== "resource") continue;
            const entryCat = (entry.category || "").toLowerCase();
            const entryTags = (entry.tags || []).join(" ").toLowerCase();
            const entryTitle = (entry.title || "").toLowerCase();
            const haystack = entryCat + " " + entryTags + " " + entryTitle;
            // Check if any part of the product category appears in the entry
            let isMatch = false;
            for (let c = 0; c < catParts.length; c++) {
              if (catParts[c].length > 2 && haystack.indexOf(catParts[c]) !== -1) {
                isMatch = true;
                break;
              }
            }
            // Also check full category slug
            if (!isMatch && haystack.indexOf(p.category) !== -1) {
              isMatch = true;
            }
            if (isMatch) matched.push(entry);
          }
          if (!matched.length) return;

          const el = document.getElementById("pdp-guides");
          let html = "";
          for (let j = 0; j < matched.length; j++) {
            const g = matched[j];
            const catLabel = g.category
              ? g.category.replace(/-/g, " ").replace(/\b\w/g, function (ch) {
                  return ch.toUpperCase();
                })
              : "Guide";
            html +=
              '<a href="' +
              esc(g.url || g.slug || "#") +
              '" class="group card-surface rounded-xl p-6 transition-all hover:-translate-y-1 hover:shadow-lg">' +
              '<span class="inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">' +
              esc(catLabel) +
              "</span>" +
              '<h3 class="mt-3 line-clamp-2 text-sm font-semibold leading-snug group-hover:text-accent">' +
              esc(g.title) +
              "</h3>" +
              '<span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-accent">' +
              "Read Guide " +
              '<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>' +
              "</span></a>";
          }
          el.innerHTML = html;
          document.getElementById("pdp-guides-section").classList.remove("hidden");
        })
        .catch(function () {
          // Silently fail — guides section stays hidden
        });
    }

    function starsHtml(rating) {
      const full = Math.round(Number(rating) || 0);
      let s = "";
      for (let i = 1; i <= 5; i++) s += i <= full ? "★" : "☆";
      return s;
    }

    function revealReviewsSection() {
      const sec = document.getElementById("pdp-reviews-section");
      if (sec) sec.classList.remove("hidden");
    }

    function renderReviews(p) {
      fetch("/api/commerce/reviews?product_id=" + encodeURIComponent(p.id))
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          const reviews = data.reviews || [];
          const list = document.getElementById("pdp-reviews");
          const empty = document.getElementById("pdp-reviews-empty");
          const summary = document.getElementById("pdp-review-summary");

          // V5.69: no reviews -> do not reveal reviews block or empty-state copy (avoid empty-template noise).
          if (!reviews.length) {
            if (empty) empty.classList.add("hidden");
            return;
          }
          revealReviewsSection();
          if (summary) {
            summary.classList.remove("hidden");
            summary.classList.add("flex");
            document.getElementById("pdp-review-avg").textContent = Number(
              data.average_rating || 0,
            ).toFixed(1);
            document.getElementById("pdp-review-stars").textContent = starsHtml(
              data.average_rating,
            );
            document.getElementById("pdp-review-count").textContent =
              (data.total || reviews.length) + " review(s)";
          }
          let html = "";
          for (let i = 0; i < reviews.length; i++) {
            const r = reviews[i];
            html +=
              '<div class="border-b border-line pb-5">' +
              '<div class="flex items-center justify-between">' +
              '<span class="text-accent">' +
              starsHtml(r.rating) +
              "</span>" +
              (r.verified_buyer
                ? '<span class="rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">Verified buyer</span>'
                : "") +
              "</div>" +
              (r.title ? '<h4 class="mt-2 text-sm font-semibold">' + esc(r.title) + "</h4>" : "") +
              '<p class="mt-1 text-sm leading-relaxed text-stone">' +
              esc(r.content) +
              "</p>" +
              '<p class="mt-2 text-xs text-stone/70">' +
              esc(r.reviewer_name || "Anonymous") +
              (r.country ? " · " + esc(r.country) : "") +
              "</p></div>";
          }
          list.innerHTML = html;
        })
        .catch(function () {
          revealReviewsSection();
        });

      // Write-review toggle + submit
      const toggle = document.getElementById("pdp-review-toggle");
      const form = document.getElementById("pdp-review-form");
      if (toggle && form) {
        toggle.addEventListener("click", function () {
          form.classList.toggle("hidden");
        });
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          const msg = document.getElementById("rv-msg");
          const payload = {
            product_id: p.id,
            reviewer_name: document.getElementById("rv-name").value.trim(),
            reviewer_email: document.getElementById("rv-email").value.trim(),
            country: document.getElementById("rv-country").value.trim(),
            rating: Number(document.getElementById("rv-rating").value),
            title: document.getElementById("rv-title").value.trim(),
            content: document.getElementById("rv-content").value.trim(),
            order_id: document.getElementById("rv-order").value.trim(),
          };
          msg.textContent = "Submitting…";
          msg.className = "text-xs text-stone";
          fetch("/api/commerce/reviews", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json().then(function (d) {
                return { ok: res.ok, d: d };
              });
            })
            .then(function (r) {
              if (r.ok && r.d.ok) {
                msg.textContent = "Thank you! Your review is pending approval.";
                msg.className = "text-xs text-green-600";
                form.reset();
                form.classList.add("hidden");
              } else {
                msg.textContent = (r.d && r.d.error) || "Failed to submit review.";
                msg.className = "text-xs text-red-600";
              }
            })
            .catch(function () {
              msg.textContent = "Network error. Please try again.";
              msg.className = "text-xs text-red-600";
            });
        });
      }
    }

    function renderQuestions(p) {
      fetch("/api/commerce/questions?product_id=" + encodeURIComponent(p.id))
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          const questions = data.questions || [];
          const list = document.getElementById("pdp-questions");
          const empty = document.getElementById("pdp-questions-empty");
          // V5.69: no questions -> do not reveal block or empty-state copy.
          if (!questions.length) {
            if (empty) empty.classList.add("hidden");
            return;
          }
          revealReviewsSection();
          let html = "";
          for (let i = 0; i < questions.length; i++) {
            const q = questions[i];
            html +=
              '<div class="border-b border-line pb-5">' +
              '<p class="text-sm font-medium text-ink">Q: ' +
              esc(q.question) +
              "</p>" +
              '<p class="mt-2 text-sm leading-relaxed text-stone">A: ' +
              esc(q.answer) +
              "</p>" +
              (q.asker_name
                ? '<p class="mt-2 text-xs text-stone/70">' + esc(q.asker_name) + "</p>"
                : "") +
              "</div>";
          }
          list.innerHTML = html;
        })
        .catch(function () {
          revealReviewsSection();
        });

      const form = document.getElementById("pdp-question-form");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          const msg = document.getElementById("qa-msg");
          const payload = {
            product_id: p.id,
            asker_name: document.getElementById("qa-name").value.trim(),
            asker_email: document.getElementById("qa-email").value.trim(),
            question: document.getElementById("qa-question").value.trim(),
          };
          msg.textContent = "Submitting…";
          msg.className = "text-xs text-stone";
          fetch("/api/commerce/questions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json().then(function (d) {
                return { ok: res.ok, d: d };
              });
            })
            .then(function (r) {
              if (r.ok && r.d.ok) {
                msg.textContent = "Question received! We'll email you once it's answered.";
                msg.className = "text-xs text-green-600";
                form.reset();
              } else {
                msg.textContent = (r.d && r.d.error) || "Failed to submit question.";
                msg.className = "text-xs text-red-600";
              }
            })
            .catch(function () {
              msg.textContent = "Network error. Please try again.";
              msg.className = "text-xs text-red-600";
            });
        });
      }
    }

    function renderJsonLd(p) {
      const tiers = p.price_tiers || [];
      const currency = tiers.length ? tiers[0].currency || "USD" : "USD";
      const pageUrl = window.location.href;
      const siteBase = window.location.origin;

      const productSchema = {
        "@type": "Product",
        name: p.title,
        image: p.cover_image || "",
        sku: p.slug,
        brand: { "@type": "Brand", name: "Aromiso" },
        category: p.category || "",
      };

      // Audit D01: old code hardcoded `short_description || description || ""` — site-wide
      // 2431 products yielded empty, and the long-description fallback would dump HTML source into structured data.
      // Now derive plain text; with no real copy, omit the key rather than fake a value with an empty string.
      const ldDesc = deriveCopy(p.short_description, p.description, 300);
      if (ldDesc) productSchema.description = ldDesc;

      if (tiers.length) {
        productSchema.offers = {
          "@type": "AggregateOffer",
          lowPrice: tiers[tiers.length - 1].unit_price,
          highPrice: tiers[0].unit_price,
          priceCurrency: currency,
          availability:
            p.stock_status === "out_of_stock"
              ? "https://schema.org/OutOfStock"
              : "https://schema.org/InStock",
          url: pageUrl,
        };
      }

      if (p.certifications && p.certifications.length) {
        productSchema.additionalProperty = p.certifications.map(function (cert) {
          return { "@type": "PropertyValue", name: "Certification", value: cert };
        });
      }

      const breadcrumbSchema = {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: siteBase + homeHref },
          { "@type": "ListItem", position: 2, name: "Shop", item: siteBase + shopHref },
          { "@type": "ListItem", position: 3, name: p.title || p.slug },
        ],
      };

      const graph = [productSchema, breadcrumbSchema];

      // FAQPage schema — only from the same real FAQ list rendered on the page
      if (pdpFaqs.length) {
        graph.push({
          "@type": "FAQPage",
          mainEntity: pdpFaqs.map(function (f) {
            return {
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            };
          }),
        });
      }

      const scriptEl = document.getElementById("pdp-jsonld");
      if (scriptEl)
        scriptEl.textContent = JSON.stringify({
          "@context": "https://schema.org",
          "@graph": graph,
        });
    }

    // ---- Axis-based Variant Selector ----
    function renderAxisSelector(p, variants) {
      const container = document.getElementById("pdp-axis-selector");
      if (!container) return;

      // V5.08: hide Chinese mirror axes (e.g. "spec1_cn") when the variant also
      // carries a non-empty English twin ("spec1_en"), so buyers only see English.
      function displayKeys(opts) {
        const allKeys = Object.keys(opts);
        const kept = [];
        for (let i = 0; i < allKeys.length; i++) {
          const k = allKeys[i];
          if (/_cn$/i.test(k)) {
            const enKey = k.replace(/_cn$/i, "_en");
            if (
              Object.prototype.hasOwnProperty.call(opts, enKey) &&
              String(opts[enKey]).trim() !== ""
            ) {
              continue; // hide the Chinese twin
            }
          }
          kept.push(k);
        }
        return kept;
      }

      // Safety: if hiding Chinese twins would make two variants indistinguishable,
      // keep all keys for this product.
      let collide = false;
      const sigSeen = {};
      for (let i = 0; i < variants.length && !collide; i++) {
        const opts = variants[i].options || {};
        const ks = displayKeys(opts);
        let sig = "";
        for (let k = 0; k < ks.length; k++) sig += ks[k] + "=" + opts[ks[k]] + "|";
        if (sigSeen[sig]) collide = true;
        sigSeen[sig] = true;
      }
      const useDisplayKeys = !collide;

      // Build axis map: { "Color": {"Red": [variant, ...], "Blue": [...]} }
      const axisMap = {};
      const axisOrder = [];
      for (let i = 0; i < variants.length; i++) {
        const opts = variants[i].options || {};
        const keys = useDisplayKeys ? displayKeys(opts) : Object.keys(opts);
        for (let k = 0; k < keys.length; k++) {
          const axisName = keys[k];
          const axisVal = opts[axisName];
          if (!axisMap[axisName]) {
            axisMap[axisName] = {};
            axisOrder.push(axisName);
          }
          if (!axisMap[axisName][axisVal]) {
            axisMap[axisName][axisVal] = [];
          }
          axisMap[axisName][axisVal].push(variants[i]);
        }
      }

      if (axisOrder.length === 0) return;

      const selections = {};
      container.innerHTML = "";

      for (let a = 0; a < axisOrder.length; a++) {
        (function (axisName) {
          const values = Object.keys(axisMap[axisName]);

          // Check if this axis has diverse images (like Fragrance) or uniform images (like Capacity)
          // Collect the "representative" image for each value
          const valueImages = {};
          for (let v = 0; v < values.length; v++) {
            const axisVariants = axisMap[axisName][values[v]];
            for (let iv = 0; iv < axisVariants.length; iv++) {
              if (axisVariants[iv].image) {
                valueImages[values[v]] = axisVariants[iv].image;
                break;
              }
            }
          }

          // Detect fragrance axes so pill rows can carry a semantic data-axis-type.
          // (English-only keywords; legacy Chinese axis names were localized out.)
          const fragranceAxisKeywords = ["fragrant", "scent", "fragrance", "aroma"];
          const axisNameLc = axisName.toLowerCase();
          // V5.16: axis names are often generic (spec1/spec2), so also look at
          // the VALUES — they carry prefixes like "Fragrance type: ...".
          const isFragranceAxis =
            fragranceAxisKeywords.some(function (kw) {
              return axisNameLc.includes(kw);
            }) ||
            values.some(function (v) {
              const vl = String(v).toLowerCase();
              return fragranceAxisKeywords.some(function (kw) {
                return vl.includes(kw);
              });
            });
          // V5.16: image buttons ONLY for fragrance axes; capacity / model
          // axes render as pure text pills (buyers compare those by wording).
          const hasAnyImages = Object.keys(valueImages).length > 0;
          const showImageButtons = isFragranceAxis && hasAnyImages;

          // V5.16: when every value shares a "Prefix: xxx" pattern (e.g.
          // "Net content: 150ml"), promote the prefix to axis label and strip
          // it from pill text — far clearer than "Option 1".
          let axisLabel = null;
          const firstPrefix = String(values[0] || "").match(/^([^:：]{2,30})[:：]/);
          if (firstPrefix) {
            const pre = firstPrefix[1];
            let allSame = values.length > 0;
            for (let v = 0; v < values.length && allSame; v++) {
              const sv = String(values[v]);
              if (sv.indexOf(pre + ":") !== 0 && sv.indexOf(pre + "：") !== 0) allSame = false;
            }
            if (allSame) axisLabel = pre;
          }
          function displayVal(val) {
            if (!axisLabel) return String(val);
            return String(val)
              .slice(axisLabel.length)
              .replace(/^[:：]\s*/, "");
          }

          // Final fix — variant option DISPLAY SOURCE only. For many 1688/excel imports the
          // axis value is still Chinese (the `spec1_en` twin was copied, not translated), so the
          // option pill shows Chinese. When that value maps to exactly ONE variant carrying a
          // reliable CJK-free English `name`, display that EXISTING English name instead.
          // RENDER-TIME ONLY: `data-value`, selection matching, image switching, price/SKU all
          // still use the raw axis value → variant business behavior is unchanged. No translation,
          // no fabrication, no data mutation. Empty / Chinese / multi-variant → keep current text.
          function labelHasCJK(s) {
            return /[\u3000-\u303f\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uff00-\uffef]/.test(
              String(s),
            );
          }
          function pillLabel(val) {
            const base = displayVal(val);
            if (!labelHasCJK(base)) return base; // already non-Chinese → untouched
            const mapped = axisMap[axisName][val] || [];
            if (mapped.length !== 1) return base; // value spans multiple variants → keep (Case D)
            const nm = String(mapped[0].name || "").trim();
            if (!nm || labelHasCJK(nm)) return base; // no reliable English name → keep (Case B/C)
            return nm; // reliable existing English variant name (Case A)
          }

          const wrapper = document.createElement("div");
          wrapper.className = "mb-5";

          const label = document.createElement("p");
          label.className = "text-sm font-semibold text-ink mb-2.5";
          const specMatch = axisName.match(/^spec(\d+)(?:_en)?$/i);
          if (axisLabel) {
            label.textContent = axisLabel;
          } else if (specMatch) {
            label.textContent = i18n.variant_option + " " + specMatch[1];
          } else {
            label.textContent = axisName.replace(/_en$/i, "");
          }
          wrapper.appendChild(label);

          const pillRow = document.createElement("div");
          pillRow.className = "flex flex-wrap gap-2.5";
          pillRow.setAttribute("data-axis", axisName);
          pillRow.setAttribute("data-axis-type", isFragranceAxis ? "fragrance" : "other");

          for (let v = 0; v < values.length; v++) {
            (function (val) {
              let btn;
              if (showImageButtons && valueImages[val]) {
                // Image button (1688-style) — only when this axis has different images per value
                btn = document.createElement("button");
                btn.type = "button";
                btn.className = "pdp-opt-btn";
                btn.innerHTML =
                  '<img src="' +
                  esc(valueImages[val]) +
                  '" alt="' +
                  esc(pillLabel(val)) +
                  '" />' +
                  '<span class="opt-name">' +
                  esc(pillLabel(val)) +
                  "</span>";
                // V5.13: hide broken variant images on load failure, keep only the text name (fallback for hotlink dead links)
                const optImg = btn.querySelector("img");
                if (optImg)
                  optImg.onerror = function () {
                    this.style.display = "none";
                  };
              } else {
                // Text pill fallback — when all values share same image or no images
                btn = document.createElement("button");
                btn.type = "button";
                btn.className = "pdp-opt-pill";
                btn.textContent = pillLabel(val);
              }

              btn.setAttribute("data-value", val);
              btn.addEventListener("click", function () {
                selections[axisName] = val;
                // Update styles
                const siblings = pillRow.querySelectorAll("button");
                for (let s = 0; s < siblings.length; s++) {
                  siblings[s].classList.remove("selected");
                }
                btn.classList.add("selected");
                // Always switch main image when variant has an image
                const shouldSwitchImage = valueImages[val];
                onAxisSelectionChanged(
                  p,
                  variants,
                  axisMap,
                  selections,
                  shouldSwitchImage ? valueImages[val] : null,
                );
              });
              pillRow.appendChild(btn);
            })(values[v]);
          }

          wrapper.appendChild(pillRow);
          container.appendChild(wrapper);
        })(axisOrder[a]);
      }

      // Auto-select first value per axis
      for (let j = 0; j < axisOrder.length; j++) {
        const firstVal = Object.keys(axisMap[axisOrder[j]])[0];
        selections[axisOrder[j]] = firstVal;
        const row = container.querySelector('[data-axis="' + axisOrder[j] + '"]');
        if (row) {
          const firstBtn = row.querySelector("button");
          if (firstBtn) firstBtn.classList.add("selected");
        }
      }

      // Set initial selected variant
      onAxisSelectionChanged(p, variants, axisMap, selections, null);
    }

    function onAxisSelectionChanged(p, variants, axisMap, selections, variantImageUrl) {
      // Find matching variant
      let matched = null;
      for (let i = 0; i < variants.length; i++) {
        const opts = variants[i].options || {};
        let isMatch = true;
        const selKeys = Object.keys(selections);
        for (let k = 0; k < selKeys.length; k++) {
          if (opts[selKeys[k]] !== selections[selKeys[k]]) {
            isMatch = false;
            break;
          }
        }
        if (isMatch) {
          matched = variants[i];
          break;
        }
      }

      if (!matched) return;
      selectedVariant = matched;
      updateOrderSummary(product);

      // Variant image switching: ONLY switch main image when variantImageUrl is provided
      // (i.e., user clicked a fragrance-type option with an associated image).
      // Capacity/size selections should NOT change the main image.
      if (variantImageUrl && !/alicdn\.com/i.test(variantImageUrl)) {
        const mainImg = document.getElementById("pdp-main-image");
        if (mainImg) {
          if (window.__pdpShowVideo) window.__pdpShowVideo(false); // V5.18: exit video mode
          mainImg.dataset.fb = "";
          mainImg.src = variantImageUrl;
          mainImg.alt = (p.title || "") + " - " + (matched.name || "");
        }
        // Highlight matching thumbnail
        const thumbs = document.getElementById("pdp-thumbnails");
        if (thumbs) {
          const allThumbs = thumbs.querySelectorAll(".pdp-thumb-btn");
          for (let t = 0; t < allThumbs.length; t++) {
            const thumbImg = allThumbs[t].querySelector("img");
            if (thumbImg && thumbImg.src === variantImageUrl) {
              allThumbs[t].classList.add("active");
            } else {
              allThumbs[t].classList.remove("active");
            }
          }
        }
      }
    }

    // ---- Supply Information (display codes only — 1688 IDs never rendered, §2.3) ----
    function populateSupplyInfo(p) {
      const section = document.getElementById("pdp-supply-section");
      const grid = document.getElementById("pdp-supply-grid");
      if (!section || !grid) return;

      const cards = [];
      if (p.display_product_code)
        cards.push({ label: i18n.supply_product_code, value: p.display_product_code });

      const skuCodes = [];
      const variants = p.variants || [];
      for (let i = 0; i < variants.length; i++) {
        const code = variants[i].display_sku_code;
        if (code && skuCodes.indexOf(code) === -1) skuCodes.push(code);
      }
      if (skuCodes.length)
        cards.push({
          label: skuCodes.length > 1 ? i18n.supply_sku_code + "s" : i18n.supply_sku_code,
          value: skuCodes.slice(0, 3).join(", ") + (skuCodes.length > 3 ? " …" : ""),
        });

      // No display codes → keep the whole section hidden
      if (!cards.length) {
        section.classList.add("hidden");
        return;
      }

      let html = "";
      for (let i = 0; i < cards.length; i++) {
        html +=
          '<div class="card-surface rounded-xl p-5">' +
          '<p class="text-xs font-medium uppercase tracking-wide text-stone">' +
          esc(cards[i].label) +
          '</p><p class="mt-1 break-words text-sm font-semibold">' +
          esc(cards[i].value) +
          "</p></div>";
      }
      grid.innerHTML = html;
      section.classList.remove("hidden");
    }

    // ---- Events ----
    function bindEvents(p) {
      const moq = p.moq || 1;
      const qtyInput = document.getElementById("pdp-qty");

      // Quantity controls
      document.getElementById("pdp-qty-minus").addEventListener("click", function () {
        const val = parseInt(qtyInput.value) || moq;
        if (val > moq) qtyInput.value = val - 1;
        updateVolumeHint(p);
        updateOrderSummary(p);
      });
      document.getElementById("pdp-qty-plus").addEventListener("click", function () {
        const val = parseInt(qtyInput.value) || moq;
        qtyInput.value = val + 1;
        updateVolumeHint(p);
        updateOrderSummary(p);
      });
      qtyInput.addEventListener("change", function () {
        const val = parseInt(qtyInput.value);
        if (isNaN(val) || val < moq) qtyInput.value = moq;
        updateVolumeHint(p);
        updateOrderSummary(p);
      });

      // Add to cart (desktop) — standard spot purchase → RFQ Cart (§2.1)
      document.getElementById("pdp-add-to-cart").addEventListener("click", function () {
        const qty = parseInt(qtyInput.value) || moq;
        const variantId = selectedVariant ? selectedVariant.id : null;
        addToCart(p.id, variantId, qty, buildSnapshot(p, selectedVariant));
        trackEvent("add_to_cart", {
          product_id: p.id,
          slug: p.slug,
          variant_id: variantId,
          quantity: qty,
          locale: locale,
        });
        showToast(i18n.added_to_cart + " — " + qty + " " + (p.unit || "pcs"));
      });

      // Add to cart (mobile bar)
      document.getElementById("pdp-mobile-add").addEventListener("click", function () {
        const qty = parseInt(qtyInput.value) || moq;
        const variantId = selectedVariant ? selectedVariant.id : null;
        addToCart(p.id, variantId, qty, buildSnapshot(p, selectedVariant));
        trackEvent("add_to_cart", {
          product_id: p.id,
          slug: p.slug,
          variant_id: variantId,
          quantity: qty,
          locale: locale,
        });
        showToast(i18n.added_to_cart + " — " + qty + " " + (p.unit || "pcs"));
      });

      // Request Bulk Quote — add to RFQ Cart with product context, then jump to cart
      const bulkBtn = document.getElementById("pdp-request-bulk-quote");
      if (bulkBtn) {
        bulkBtn.addEventListener("click", function () {
          const qty = parseInt(qtyInput.value) || moq;
          const variantId = selectedVariant ? selectedVariant.id : null;
          addToCart(p.id, variantId, qty, buildSnapshot(p, selectedVariant));
          trackEvent("request_bulk_quote", {
            product_id: p.id,
            slug: p.slug,
            variant_id: variantId,
            quantity: qty,
            locale: locale,
          });
          window.location.href = cartHref;
        });
      }

      // Request sample link with product context
      const sampleLink = document.getElementById("pdp-request-sample");
      if (sampleLink) {
        sampleLink.href = contactHref + "?subject=sample&product=" + encodeURIComponent(p.slug);
      }
      const shippingLink = document.getElementById("pdp-request-shipping");
      if (shippingLink) {
        shippingLink.href =
          contactHref + "?subject=shipping-quote&product=" + encodeURIComponent(p.slug);
      }
      const oemLink = document.getElementById("pdp-request-oem");
      if (oemLink) {
        oemLink.href = oemHref + "?product=" + encodeURIComponent(p.slug);
      }
    }
  })();
</script>
