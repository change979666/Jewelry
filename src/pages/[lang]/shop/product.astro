---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SocialContactButtons from "../../../components/SocialContactButtons.astro";
import Icon from "../../../components/Icon.astro";
import { t, localeStaticPaths } from "../../../i18n";
import type { Locale } from "../../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

export const getStaticPaths = localeStaticPaths;

const locale = (Astro.props.locale as Locale) ?? "en";
const shopHref = getRelativeLocaleUrl(locale, "/shop");
const contactHref = getRelativeLocaleUrl(locale, "/contact");
const oemHref = getRelativeLocaleUrl(locale, "/oem");
const homeHref = getRelativeLocaleUrl(locale, "/");
const resourcesHref = getRelativeLocaleUrl(locale, "/resources");
const cartHref = getRelativeLocaleUrl(locale, "/cart");

// V5.0 trilingual strings for client-rendered content (Order Summary, Supply,
// toasts). Server-side static labels use t() directly in the markup below.
const pdpI18n = {
  add_to_cart: t(locale, "shop.add_to_cart"),
  add_to_cart_note: t(locale, "shop.add_to_cart_note"),
  why_buy_title: t(locale, "shop.why_buy_title"),
  full_specs_btn: t(locale, "shop.full_specs_btn"),
  full_specs_title: t(locale, "shop.full_specs_title"),
  request_sample: t(locale, "shop.request_sample"),
  request_bulk_quote: t(locale, "shop.request_bulk_quote"),
  request_oem_quote: t(locale, "shop.request_oem_quote"),
  order_summary: t(locale, "shop.order_summary"),
  os_product: t(locale, "shop.os_product"),
  os_qty: t(locale, "shop.os_qty"),
  os_unit_price: t(locale, "shop.os_unit_price"),
  os_subtotal: t(locale, "shop.os_subtotal"),
  os_est_weight: t(locale, "shop.os_est_weight"),
  os_shipping: t(locale, "shop.os_shipping"),
  os_shipping_request: t(locale, "shop.os_shipping_request"),
  os_est_total: t(locale, "shop.os_est_total"),
  os_packaging_note: t(locale, "shop.os_packaging_note"),
  to_be_confirmed: t(locale, "shop.to_be_confirmed"),
  est_weight: t(locale, "shop.est_weight"),
  added_to_cart: t(locale, "shop.added_to_cart"),
  supply_product_code: t(locale, "shop.supply_product_code"),
  supply_sku_code: t(locale, "shop.supply_sku_code"),
  variant_option: t(locale, "shop.variant_option"),
  bulk_quote_note: t(locale, "shop.bulk_quote_note"),
  contact_us_on: t(locale, "shop.contact_us_on"),
  facebook_page: t(locale, "shop.facebook_page"),
  messenger: t(locale, "shop.messenger"),
  whatsapp_chat: t(locale, "shop.whatsapp_chat"),
  // Audit D01: explicit incomplete state when required copy is missing
  copy_pending_label: t(locale, "shop.copy_pending_label"),
  copy_pending: t(locale, "shop.copy_pending"),
  // 面包屑可见导航所需文案（客户端脚本无 t()，必须在服务端注入）
  nav_home: t(locale, "nav.home"),
  nav_shop: t(locale, "nav.shop"),
};
---

<BaseLayout locale={locale} title="Product Details" description="B2B product detail page">
  <!-- Loading Skeleton -->
  <div id="pdp-loading" class="container-x py-12 lg:py-20">
    <div class="animate-pulse">
      <!-- Breadcrumb skeleton -->
      <div class="mb-8 h-4 w-64 rounded bg-beige"></div>
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <!-- Gallery skeleton (vertical thumbs + main) -->
        <div>
          <div class="flex gap-3">
            <div class="flex flex-col gap-2">
              {[1, 2, 3, 4, 5].map(() => <div class="h-[72px] w-[72px] rounded-lg bg-beige" />)}
            </div>
            <div class="flex-1 aspect-square rounded-xl bg-beige"></div>
          </div>
        </div>
        <!-- Purchase panel skeleton -->
        <div class="space-y-5">
          <div class="h-8 w-3/4 rounded bg-beige"></div>
          <div class="h-4 w-full rounded bg-beige"></div>
          <div class="h-4 w-2/3 rounded bg-beige"></div>
          <div class="mt-6 h-16 w-full rounded-xl bg-beige"></div>
          <div class="mt-6 h-32 w-full rounded-xl bg-beige"></div>
          <div class="h-12 w-full rounded-full bg-beige"></div>
          <div class="h-12 w-full rounded-full bg-beige"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 404 / Not Found -->
  <div id="pdp-not-found" class="container-x hidden py-24 text-center">
    <div class="mx-auto max-w-md">
      <svg
        class="mx-auto mb-6 h-16 w-16 text-stone/40"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
      </svg>
      <h1 class="text-2xl font-semibold tracking-tight">{t(locale, "shop.pnf_title")}</h1>
      <p class="mt-3 text-stone">{t(locale, "shop.pnf_desc")}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={shopHref} class="btn btn-primary">{t(locale, "shop.pnf_shop_btn")}</a>
        <a href={oemHref} class="btn btn-ghost">{t(locale, "shop.pnf_oem_btn")}</a>
        <a href={resourcesHref} class="btn btn-ghost">{t(locale, "shop.pnf_guides_btn")}</a>
      </div>
    </div>
  </div>

  <!-- Product Detail (hidden until data loads) -->
  <div id="pdp-content" class="hidden">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="container-x pt-8">
      <ol
        id="pdp-breadcrumb"
        class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stone"
      >
      </ol>
    </nav>

    <!-- Two-column: Gallery + Purchase Panel -->
    <section class="container-x py-6 lg:py-10">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-10">
        <!-- Left: Gallery — image on top, fact strip + thumbs below (mockup layout).
             Top-aligned with the product title on desktop. -->
        <div class="min-w-0 lg:self-start">
          <div class="pdp-gallery-wrap">
            <div class="pdp-main-col">
              <img
                id="pdp-main-image"
                src=""
                alt=""
                onerror="window.__pdpMainFallback && window.__pdpMainFallback(this)"
                class="w-full rounded-xl border border-line bg-[#f5f3ef] block"
              />
              <!-- V5.18: product video — shown preferentially when video_url exists -->
              <video
                id="pdp-main-video"
                class="hidden w-full rounded-xl border border-line bg-black block"
                controls
                playsinline
                preload="metadata"></video>
            </div>
            <div id="pdp-thumbnails" class="pdp-thumbs-col"></div>
            <!-- Packaging facts (size / weight / carton) — muted cards, real data only -->
            <div id="pdp-hero-packaging" class="hidden"></div>
            <!-- Key Features fills the space under the gallery (design mockup) -->
            <div id="pdp-hero-features" class="hidden"></div>
            <!-- Below main image: quick-contact card -->
            <div class="mt-5 rounded-xl border border-line bg-card p-4">
              <p class="text-sm font-semibold text-ink">{t(locale, "shop.contact_us_on")}</p>
              <a
                href="mailto:sales@aromiso.com"
                class="mt-1 block text-sm text-amber-600 hover:underline">sales@aromiso.com</a
              >
              <div class="mt-3">
                <SocialContactButtons locale={locale} variant="full" refUrl={Astro.url.href} />
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Purchase Panel -->
        <div class="min-w-0">
          <!-- Title -->
          <h1
            id="pdp-title"
            class="text-xl font-semibold tracking-tight sm:text-2xl lg:text-[1.7rem] leading-snug"
          >
          </h1>
          <p id="pdp-short-desc" class="mt-2 text-sm leading-relaxed text-stone line-clamp-2"></p>

          <!--
            Audit D01 — explicit incomplete state.
            short_description is required display copy; historically 2431 active products had it empty,
            and the <p> above rendered as blank whitespace that looked like a normal short description.
            When both short and long description are missing, client script hides the <p> above and shows this block,
            telling buyers the copy is not ready — missing is missing, never disguised or fabricated.
          -->
          <div
            id="pdp-copy-pending"
            class="mt-3 hidden rounded-lg border border-dashed border-line bg-beige/40 px-3.5 py-3"
            role="status"
          >
            <p class="text-[11px] font-semibold uppercase tracking-wide text-stone">
              {t(locale, "shop.copy_pending_label")}
            </p>
            <p class="mt-1 text-xs leading-relaxed text-stone">
              {t(locale, "shop.copy_pending")}
            </p>
          </div>

          <!-- Badges -->
          <div id="pdp-badges" class="mt-3 flex flex-wrap gap-2"></div>

          <!-- Price Display - Prominent -->
          <div
            id="pdp-price-display"
            class="mt-4 rounded-xl bg-gradient-to-r from-red-50 to-amber-50/50 px-5 py-3 border border-red-100"
          >
            <div class="flex items-baseline gap-2">
              <span id="pdp-price-from" class="text-sm font-medium text-stone">From</span>
              <span id="pdp-price-main" class="text-[1.65rem] font-bold text-red-600 tracking-tight"
                >--</span
              >
              <span id="pdp-price-unit" class="text-sm text-stone">/ piece</span>
            </div>
            <p id="pdp-price-tier-hint" class="mt-1 text-xs text-stone">
              Volume discounts available
            </p>
          </div>

          <!-- B2B Info Cards - Key info above fold -->
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-lg border border-line bg-card p-3 text-center">
              <p class="text-[10px] font-medium uppercase tracking-wider text-stone">MOQ</p>
              <p id="pdp-info-moq" class="mt-1 text-sm font-semibold text-ink">--</p>
            </div>
            <div class="rounded-lg border border-line bg-card p-3 text-center">
              <p class="text-[10px] font-medium uppercase tracking-wider text-stone">
                Ready to Ship
              </p>
              <p id="pdp-info-stock" class="mt-1 text-sm font-semibold text-green-700">--</p>
            </div>
            <div class="rounded-lg border border-line bg-card p-3 text-center">
              <p class="text-[10px] font-medium uppercase tracking-wider text-stone">Sample</p>
              <p id="pdp-info-sample" class="mt-1 text-sm font-semibold text-green-700">
                Available
              </p>
            </div>
            <div class="rounded-lg border border-line bg-card p-3 text-center">
              <p class="text-[10px] font-medium uppercase tracking-wider text-stone">OEM/ODM</p>
              <p id="pdp-info-oem" class="mt-1 text-sm font-semibold text-ink">Supported</p>
            </div>
          </div>

          <!-- Variant Selector -->
          <div id="pdp-variant-section" class="mt-5 hidden">
            <div id="pdp-axis-selector"></div>
          </div>

          <!-- Quantity + Price Tier -->
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <!-- Quantity -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-stone">Quantity</h3>
              <div class="mt-2 flex items-center gap-3">
                <div class="flex items-center rounded-lg border border-line">
                  <button
                    id="pdp-qty-minus"
                    class="px-3 py-2 text-lg leading-none text-stone transition-colors hover:text-ink"
                    aria-label="Decrease quantity">-</button
                  >
                  <input
                    id="pdp-qty"
                    type="number"
                    min="1"
                    value="1"
                    class="w-16 border-x border-line bg-transparent py-2 text-center text-sm font-medium outline-none"
                  />
                  <button
                    id="pdp-qty-plus"
                    class="px-3 py-2 text-lg leading-none text-stone transition-colors hover:text-ink"
                    aria-label="Increase quantity">+</button
                  >
                </div>
                <span id="pdp-moq-note" class="text-xs text-stone"></span>
              </div>
            </div>

            <!-- Volume Pricing (compact) -->
            <div id="pdp-price-section">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-stone">
                Volume Pricing
              </h3>
              <div class="mt-2 overflow-hidden rounded-lg border border-line">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="border-b border-line bg-beige/50 text-left">
                      <th class="px-3 py-2 font-medium">Qty</th>
                      <th class="px-3 py-2 font-medium">Unit Price</th>
                    </tr>
                  </thead>
                  <tbody id="pdp-price-tiers"></tbody>
                </table>
              </div>
              <div
                id="pdp-volume-hint"
                class="hidden mt-2 rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800"
              >
              </div>
            </div>
          </div>

          <!-- CTA Buttons — V5.0 three-layer model (§2.2) -->
          <div class="mt-6 space-y-3">
            <button
              id="pdp-add-to-cart"
              class="w-full rounded-full bg-amber-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-amber-500/25 transition-all hover:bg-amber-600 hover:shadow-amber-500/40 active:scale-[0.98]"
            >
              {t(locale, "shop.add_to_cart")}
            </button>
            <p class="mt-1 text-center text-[11px] text-stone">
              {t(locale, "shop.add_to_cart_note")}
            </p>
            <!-- Social Contact Buttons (right under Add to Cart) -->
            <div id="pdp-social-contact"></div>
            <button
              id="pdp-request-bulk-quote"
              class="w-full rounded-full border border-line px-6 py-3.5 text-sm font-semibold text-ink transition-all hover:bg-beige"
            >
              {t(locale, "shop.request_bulk_quote")}
            </button>
            <div class="grid grid-cols-2 gap-3">
              <a
                id="pdp-request-sample"
                href={contactHref}
                class="inline-flex items-center justify-center rounded-full border border-line px-4 py-2.5 text-sm font-medium text-ink transition-all hover:bg-beige"
              >
                {t(locale, "shop.request_sample")}
              </a>
              <a
                id="pdp-request-oem"
                href={oemHref}
                class="inline-flex items-center justify-center rounded-full border border-line px-4 py-2.5 text-sm font-medium text-ink transition-all hover:bg-beige"
              >
                {t(locale, "shop.request_oem_quote")} →
              </a>
            </div>
          </div>

          <!-- Order Summary (live quote — NOT a payment, §2.1) -->
          <div
            id="pdp-order-summary"
            class="mt-5 hidden rounded-2xl border border-line bg-beige/30 p-5"
          >
            <h3 class="text-sm font-semibold tracking-tight">{t(locale, "shop.order_summary")}</h3>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_product")}</dt>
                <dd id="pdp-os-product" class="text-right font-medium"></dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_qty")}</dt>
                <dd id="pdp-os-qty" class="text-right font-medium"></dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_unit_price")}</dt>
                <dd id="pdp-os-unit" class="text-right font-medium"></dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_subtotal")}</dt>
                <dd id="pdp-os-subtotal" class="text-right font-medium"></dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_est_weight")}</dt>
                <dd id="pdp-os-weight" class="text-right font-medium"></dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-stone">{t(locale, "shop.os_shipping")}</dt>
                <dd id="pdp-os-shipping" class="text-right font-medium text-accent">
                  {t(locale, "shop.os_shipping_request")}
                </dd>
              </div>
              <div class="flex justify-between gap-3 border-t border-line pt-2">
                <dt class="font-semibold">{t(locale, "shop.os_est_total")}</dt>
                <dd id="pdp-os-total" class="text-right font-semibold"></dd>
              </div>
            </dl>
            <p class="mt-3 text-[11px] leading-relaxed text-stone/70">
              {t(locale, "shop.os_packaging_note")}
            </p>
          </div>

          <!-- Trust Signals - Compact (B2B factory positioning) -->
          <div
            class="mt-5 flex items-center justify-between gap-3 rounded-lg border border-line bg-beige/30 px-4 py-3 text-xs text-stone"
          >
            <div class="flex items-center gap-1.5">
              <svg
                class="h-4 w-4 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                ></path></svg
              >
              <span>Strict Quality Control</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg
                class="h-4 w-4 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                ></path></svg
              >
              <span>Fast Dispatch</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg
                class="h-4 w-4 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
                ></path></svg
              >
              <span>Pre-Shipment Inspection</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Below the fold sections -->
    <div class="border-t border-line">
      <!-- Key Specifications -->
      <section id="pdp-specs-section" class="container-x py-14">
        <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">Key Specifications</h2>
        <div class="mt-6 overflow-hidden rounded-xl border border-line">
          <table class="w-full text-sm">
            <tbody id="pdp-specs-table"></tbody>
          </table>
        </div>
        <!-- Level 3: Full Technical Data (collapsible) -->
        <div id="pdp-full-specs-wrap" class="mt-4 hidden">
          <button
            id="pdp-full-specs-toggle"
            class="flex w-full items-center justify-between rounded-xl border border-line px-5 py-3 text-left text-sm font-medium transition-colors hover:bg-beige/50"
          >
            <span>View Full Specifications</span>
            <svg
              id="pdp-full-specs-chevron"
              class="h-4 w-4 transition-transform"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg
            >
          </button>
          <div
            id="pdp-full-specs-body"
            class="mt-3 hidden overflow-hidden rounded-xl border border-line"
          >
            <table class="w-full text-sm">
              <tbody id="pdp-full-specs-table"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Packaging & Shipping (merged: real logistics data + estimator + packaging options) -->
      <section id="pdp-packaging-section" class="border-t border-line bg-beige/30">
        <div class="container-x py-14">
          <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">Packaging & Shipping</h2>
          <!-- Logistics stat cards (real data only — "To be confirmed" when missing) -->
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="card-surface rounded-xl p-5">
              <p class="text-xs font-medium uppercase tracking-wide text-stone">Product Size</p>
              <p class="mt-1 text-sm font-semibold" id="pdp-product-size">To be confirmed</p>
            </div>
            <div class="card-surface rounded-xl p-5">
              <p class="text-xs font-medium uppercase tracking-wide text-stone">Unit Weight</p>
              <p class="mt-1 text-sm font-semibold" id="pdp-unit-weight">To be confirmed</p>
            </div>
            <div class="card-surface rounded-xl p-5">
              <p class="text-xs font-medium uppercase tracking-wide text-stone">Units / Carton</p>
              <p class="mt-1 text-sm font-semibold" id="pdp-pcs-carton">To be confirmed</p>
            </div>
            <div class="card-surface rounded-xl p-5">
              <p class="text-xs font-medium uppercase tracking-wide text-stone">Carton Volume</p>
              <p class="mt-1 text-sm font-semibold" id="pdp-carton-volume">To be confirmed</p>
            </div>
          </div>

          <div class="mt-8 grid gap-6 lg:grid-cols-2">
            <!-- Shipping Estimator -->
            <div class="card-surface rounded-xl p-6">
              <h3 class="font-semibold">Shipping Estimator</h3>
              <p class="mt-1 text-sm text-stone">
