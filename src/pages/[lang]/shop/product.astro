<script>
  // Bundled module (processed by Astro/Vite): expose the unit-tested, context-aware
  // spec-localization functions to the is:inline PDP render script below, which cannot
  // import modules. Render-time DISPLAY layer only — source data is never mutated.
  import { localizeSpecKey, localizeSpecValue } from "../../../lib/spec-localization";
  (window as unknown as Record<string, unknown>).__aromisoSpecLoc = {
    localizeSpecKey,
    localizeSpecValue,
  };
</script>
<script
  is:inline
  define:vars={{
    locale,
    shopHref,
    contactHref,
    oemHref,
    homeHref,
    cartHref,
    i18n: pdpI18n,
  }}
>
  (function () {
    "use strict";

    // ---- Helpers ----
    const API = "/api/commerce/products";
    const CART_KEY = "aromiso_cart";

    function getSlug() {
      const path = window.location.pathname;
      const parts = path.split("/").filter(function (p) {
        return p !== "";
      });
      // parts = ["en","shop","abc12345"] → last is the slug or short_id
      const seg = parts[parts.length - 1] || "";
      // "product" and "compare" are reserved shell paths, not real slugs
      if (seg === "product" || seg === "compare") return "";
      return seg;
    }

    function esc(str) {
      const d = document.createElement("div");
      d.textContent = str || "";
      return d.innerHTML;
    }

    // ---- Audit D01 helpers -------------------------------------------------
    // server-side source of truth is functions/lib/product-short-description.ts (edge SSR uses the same
    // rules). This inline copy must stay consistent with it: the DB description is `<p>…</p>`
    // HTML and must never be dumped raw into meta description / JSON-LD.
    function plainText(html) {
      return String(html || "")
        .replace(/<\s*(script|style)\b[^>]*>[\s\S]*?<\s*\/\s*\1\s*>/gi, " ")
        .replace(/<[^>]*>/g, " ")
        .replace(/&nbsp;/gi, " ")
        .replace(/&lt;/gi, "<")
        .replace(/&gt;/gi, ">")
        .replace(/&quot;/gi, '"')
        .replace(/&#0*39;|&apos;/g, "'")
        .replace(/&#0*(\d+);/g, function (_m, d) {
          return String.fromCharCode(Number(d));
        })
        .replace(/&amp;/gi, "&")
        .replace(/&[a-z][a-z0-9]{1,10};/gi, " ")
        .replace(/\s+/g, " ")
        .trim();
    }

    /** Truncate to max chars at word boundaries; never split a word; append an ellipsis to signal an excerpt. */
    function clipSentence(text, max) {
      const s = String(text || "").trim();
      if (!s) return "";
      if (s.length <= max) return s;
      const cut = s.slice(0, max);
      const sp = cut.lastIndexOf(" ");
      const body = (sp > max * 0.6 ? cut.slice(0, sp) : cut).replace(/[\s,;:—–-]+$/, "");
      return body ? body + "\u2026" : "";
    }

    /**
     * Deterministically derive meta description / JSON-LD description:
     * prefer the existing short description, else the first sentence of the long description. No fabrication; empty string when no source.
     */
    function deriveCopy(shortDesc, longDesc, max) {
      const limit = max || 160;
      const short = plainText(shortDesc);
      if (short) return clipSentence(short, limit);
      const long = plainText(longDesc);
      if (!long) return "";
      if (long.length <= limit) return long;
      const sentence = long.match(/^[^.!?]{20,}?[.!?](?=\s|$)/);
      if (sentence && sentence[0].length <= limit) return sentence[0];
      return clipSentence(long, limit);
    }

    function formatPrice(val, currency) {
      const sym = currency === "EUR" ? "\u20AC" : currency === "GBP" ? "\u00A3" : "$";
      return sym + Number(val).toFixed(2);
    }

    // ---- GA4 ----
    function trackEvent(name, params) {
      if (typeof gtag === "function") gtag("event", name, params || {});
    }

    // ---- Cart ----
    function getCart() {
      try {
        return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
      } catch (_e) {
        return [];
      }
    }
    function saveCart(cart) {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
    }
    function addToCart(productId, variantId, quantity, snapshot) {
      const cart = getCart();
      let found = false;
      for (let i = 0; i < cart.length; i++) {
        if (cart[i].product_id === productId && cart[i].variant_id === variantId) {
          cart[i].quantity += quantity;
          found = true;
          break;
        }
      }
      if (!found) {
        const item = { product_id: productId, variant_id: variantId || null, quantity: quantity };
        if (snapshot && typeof snapshot === "object") {
          Object.assign(item, snapshot);
        }
        cart.push(item);
      }
      saveCart(cart);
    }

    // ---- Toast ----
    function showToast(msg) {
      const toast = document.getElementById("pdp-toast");
      if (!toast) return;
      toast.textContent = msg || "Added to cart";
      toast.classList.remove("opacity-0", "pointer-events-none");
      toast.classList.add("opacity-100");
      setTimeout(function () {
        toast.classList.add("opacity-0", "pointer-events-none");
        toast.classList.remove("opacity-100");
      }, 2500);
    }

    // ---- V5.0 pricing / weight / order-summary helpers ----
    function dedupeTiers(p) {
      const raw = p.price_tiers || [];
      const map = {};
      for (let i = 0; i < raw.length; i++) {
        const key = raw[i].min_qty + "|" + (raw[i].max_qty || "null");
        if (!map[key] || raw[i].unit_price < map[key].unit_price) map[key] = raw[i];
      }
      return Object.values(map).sort(function (a, b) {
        return a.min_qty - b.min_qty;
      });
    }
    function lowestTierPrice(p) {
      const tiers = dedupeTiers(p);
      if (!tiers.length) return 0;
      let min = tiers[0].unit_price;
      for (let i = 1; i < tiers.length; i++) {
        if (tiers[i].unit_price < min) min = tiers[i].unit_price;
      }
      return min;
    }
    function tierUnitPriceForQty(p, qty) {
      const tiers = dedupeTiers(p);
      if (!tiers.length) return 0;
      let price = tiers[0].unit_price;
      for (let i = 0; i < tiers.length; i++) {
        if (qty >= tiers[i].min_qty) price = tiers[i].unit_price;
      }
      return price;
    }
    function buildSnapshot(p, variant) {
      return {
        title: p.title || p.seo_title || "",
        slug: p.slug || "",
        cover_image: p.cover_image || "",
        unit: p.unit || "pcs",
        weight_kg:
          variant && variant.weight_kg
            ? Number(variant.weight_kg)
            : p.weight
              ? Number(p.weight)
              : 0,
        display_product_code: p.display_product_code || "",
        display_sku_code: variant && variant.display_sku_code ? variant.display_sku_code : "",
        price_from: lowestTierPrice(p),
      };
    }
    function updateOrderSummary(p) {
      const panel = document.getElementById("pdp-order-summary");
      if (!panel) return;
      const qtyInput = document.getElementById("pdp-qty");
      const qty = parseInt((qtyInput && qtyInput.value) || "") || p.moq || 1;
      const unit = tierUnitPriceForQty(p, qty);
      const subtotal = unit * qty;
      const unitWeight =
        selectedVariant && selectedVariant.weight_kg
          ? Number(selectedVariant.weight_kg)
          : p.weight
            ? Number(p.weight)
            : 0;
      const estWeight = unitWeight * qty;

      const prodLabel =
        (p.title || p.seo_title || "") +
        (selectedVariant && selectedVariant.name ? " · " + selectedVariant.name : "") +
        (p.display_product_code ? " (" + p.display_product_code + ")" : "");

      const osProduct = document.getElementById("pdp-os-product");
      const osQty = document.getElementById("pdp-os-qty");
      const osUnit = document.getElementById("pdp-os-unit");
      const osSubtotal = document.getElementById("pdp-os-subtotal");
      const osWeight = document.getElementById("pdp-os-weight");
      const osTotal = document.getElementById("pdp-os-total");
      if (osProduct) osProduct.textContent = prodLabel;
      if (osQty) osQty.textContent = qty + " " + (p.unit || "pcs");
      if (osUnit) osUnit.textContent = unit > 0 ? formatPrice(unit, "USD") : i18n.to_be_confirmed;
      if (osSubtotal)
        osSubtotal.textContent = subtotal > 0 ? formatPrice(subtotal, "USD") : i18n.to_be_confirmed;
      if (osWeight)
        osWeight.textContent =
          unitWeight > 0 ? "≈ " + estWeight.toFixed(1) + " kg" : i18n.to_be_confirmed;
      if (osTotal)
        osTotal.textContent = subtotal > 0 ? formatPrice(subtotal, "USD") : i18n.to_be_confirmed;
      panel.classList.remove("hidden");
    }

    // ---- State ----
    let product = null;
    let selectedVariant = null;
    let pdpFaqs = [];

    // ---- Init ----
    const urlSeg = getSlug();
    if (!urlSeg) {
      showNotFound();
    } else {
      fetchProduct(urlSeg);
    }

    function showNotFound() {
      // V5.69: not-found and product detail must be mutually exclusive. When showing not-found, force-hide
      // product content / mobile buy bar so a 404 notice and an empty template never appear together.
      document.getElementById("pdp-loading").classList.add("hidden");
      const content = document.getElementById("pdp-content");
      if (content) content.classList.add("hidden");
      const mobileBar = document.getElementById("pdp-mobile-bar");
      if (mobileBar) mobileBar.classList.add("hidden");
      document.getElementById("pdp-not-found").classList.remove("hidden");
    }

    // Check if a string looks like a short_id (10 hex chars)
    function isShortId(s) {
      return /^[a-f0-9]{10}$/i.test(s);
    }

    function fetchProduct(seg) {
      // Build the right query param: ?id= for short_id, ?slug= for slug
      const queryParam = isShortId(seg)
        ? "id=" + encodeURIComponent(seg)
        : "slug=" + encodeURIComponent(seg);
      fetch(API + "?" + queryParam)
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (!data.ok || !data.product) {
            showNotFound();
            return;
          }
          product = data.product;
          // Redirect to canonical short_id URL if the URL still uses the old slug
          const canonicalId = product.short_id || "";
          if (canonicalId && seg !== canonicalId) {
            // Replace URL with short_id (no page reload)
            const newPath = "/" + locale + "/shop/" + encodeURIComponent(canonicalId);
            window.history.replaceState({}, "", newPath);
          }
          renderPage(product);
        })
        .catch(function (err) {
          // V5.324: never swallow render errors silently again (blank-section bug)
          if (window.console && console.error) console.error("[pdp] render failed:", err);
          showNotFound();
        });
    }

    // ---- Render ----
    // V5.69: validate minimal product validity before render; invalid -> clean not-found (no buy/quote template).
    // Each sub-render has its own try/catch: a single failure only affects that block (stays hidden), no half-rendered page,
    // and never bubbles into a not-found + empty-template co-display.
    function safeRender(fn, name) {
      try {
        fn();
      } catch (e) {
        if (window.console && console.error) console.error("[pdp] section failed:", name, e);
      }
    }
    // V5.69 locale integrity: some legacy rows carry a Chinese short_name while title is
    // English. Public EN/ES/DE pages must never render CJK, so prefer short_name only when
    // it is CJK-free; otherwise fall back to the (English) title / seo_title.
    function displayName(p) {
      const sn = p.short_name || "";
      const hasCjk = /[\u4e00-\u9fff]/.test(sn);
      if (sn && !hasCjk) return sn;
      return p.title || p.seo_title || sn || "";
    }
    function renderPage(p) {
      if (!p || !(p.title || p.short_name || p.slug || p.short_id)) {
        showNotFound();
        return;
      }
      document.getElementById("pdp-loading").classList.add("hidden");
      document.getElementById("pdp-not-found").classList.add("hidden");
      document.getElementById("pdp-content").classList.remove("hidden");

      safeRender(() => renderBreadcrumb(p), "breadcrumb");
      safeRender(() => renderGallery(p), "gallery");
      safeRender(() => renderPurchasePanel(p), "purchase");
      safeRender(() => renderHeroFeatures(p), "hero");
      safeRender(() => renderSocialButtons(p), "social");
      safeRender(() => renderSpecs(p), "specs");
      safeRender(() => renderHighlights(p), "highlights");
      safeRender(() => renderDescription(p), "description");
      safeRender(() => renderPackaging(p), "packaging");
      safeRender(() => renderFaq(p), "faq");
      safeRender(() => renderRelated(p), "related");
      safeRender(() => renderGuides(p), "guides");
      safeRender(() => renderReviews(p), "reviews");
      safeRender(() => renderQuestions(p), "questions");
      safeRender(() => renderJsonLd(p), "jsonld");
      safeRender(() => bindEvents(p), "events");

      // Show mobile bar
      const mobileBar = document.getElementById("pdp-mobile-bar");
      if (mobileBar) mobileBar.classList.remove("hidden");

      // GA4 product view
      trackEvent("commerce_product_view", {
        product_id: p.id,
        slug: p.slug,
        title: p.title,
        category: p.category,
        locale: locale,
      });
    }

    function renderBreadcrumb(p) {
      const ol = document.getElementById("pdp-breadcrumb");
      const crumbName = displayName(p);
      const catLabel = p.category
        ? p.category.replace(/-/g, " ").replace(/\b\w/g, function (c) {
            return c.toUpperCase();
          })
        : i18n.nav_shop;
      // V5.69: Category must be a clickable breadcrumb pointing at the real Shop category filter (?category=).
      const catHref = p.category
        ? shopHref + "?category=" + encodeURIComponent(p.category)
        : shopHref;
      ol.innerHTML =
        '<li><a href="' +
        homeHref +
        '" class="transition-colors hover:text-ink">' +
        esc(i18n.nav_home) +
        "</a></li>" +
        '<li><span class="text-stone/50">/</span></li>' +
        '<li><a href="' +
        shopHref +
        '" class="transition-colors hover:text-ink">' +
        esc(i18n.nav_shop) +
        "</a></li>" +
        '<li><span class="text-stone/50">/</span></li>' +
        '<li><a href="' +
        catHref +
        '" class="transition-colors hover:text-ink" title="' +
        esc(catLabel) +
        '">' +
        esc(catLabel) +
        "</a></li>" +
        '<li><span class="text-stone/50">/</span></li>' +
        '<li class="min-w-0"><span class="font-medium text-ink inline-block max-w-[220px] sm:max-w-[420px] truncate align-bottom" aria-current="page" title="' +
        esc(crumbName) +
        '">' +
        esc(crumbName) +
        "</span></li>";
    }

    // V5.13: main-image broken fallback — on src load failure fall back to the first usable image in __pdpImages,
    // so buyers never see a broken image (dataset.fb prevents a loop if the fallback also fails)
    window.__pdpMainFallback = function (img) {
      if (img.dataset.fb === "1") return;
      img.dataset.fb = "1";
      const list = window.__pdpImages || [];
      for (let i = 0; i < list.length; i++) {
        if (list[i] && list[i] !== img.src && !/alicdn\.com/i.test(list[i])) {
          img.src = list[i];
          return;
        }
      }
    };

    function renderGallery(p) {
      // Collect all unique images: cover → gallery → variant images
      const images = [];
      function addImg(url) {
        // V5.13: alicdn external links are hotlink-protected and always break in render — excluded at render layer (data layer already on R2; this is the fallback)
        if (url && !/alicdn\.com/i.test(url) && images.indexOf(url) === -1) images.push(url);
      }
      if (p.cover_image) addImg(p.cover_image);
      if (p.gallery && p.gallery.length) {
        for (let gi = 0; gi < p.gallery.length; gi++) {
          addImg(p.gallery[gi] && (p.gallery[gi].url || p.gallery[gi]));
        }
      }
      // Add variant images so thumbnails show different product views
      const variants = p.variants || [];
      for (let vi = 0; vi < variants.length; vi++) {
        addImg(variants[vi].image);
      }
      if (!images.length) images.push("/images/placeholder-product.jpg");

      // Store for variant switching
      window.__pdpImages = images;

      // V5.18: product video — preferential display on PDP (shop listing keeps cover image)
      const videoUrl = typeof p.video_url === "string" ? p.video_url.trim() : "";
      const mainImg = document.getElementById("pdp-main-image");
      const mainVideo = document.getElementById("pdp-main-video");

      function showVideo(on) {
        if (!mainVideo) return;
        if (on) {
          mainImg.classList.add("hidden");
          mainVideo.classList.remove("hidden");
        } else {
          mainVideo.classList.add("hidden");
          mainVideo.pause();
          mainImg.classList.remove("hidden");
        }
      }
      window.__pdpShowVideo = showVideo;

      mainImg.dataset.fb = "";
      mainImg.src = images[0];
      mainImg.alt = p.title || "Product image";

      if (mainVideo) {
        if (videoUrl) {
          mainVideo.src = videoUrl;
          mainVideo.poster = images[0] || "";
          showVideo(true);

          // Studio V1 video slot: fire self-built video_view once on first real play.
          // Asset id = URL filename without extension (used later as source_video_id).
          const assetId =
            (videoUrl.split("/").pop() || "").replace(/\.[a-z0-9]+$/i, "") || "unknown";
          mainVideo.dataset.videoAssetId = assetId;
          mainVideo.addEventListener("play", function () {
            if (mainVideo.dataset.viewTracked) return;
            mainVideo.dataset.viewTracked = "1";
            try {
              localStorage.setItem(
                "_aro_last_video",
                JSON.stringify({ id: assetId, ts: Date.now() }),
              );
            } catch (_e) {
              /* noop */
            }
            try {
              let sid = "";
              try {
                sid = localStorage.getItem("_aro_sid") || "";
              } catch (_e) {
                /* noop */
              }
              const payload = {
                event_type: "video_view",
                page: location.pathname,
                label: assetId,
                product_slug: p.slug || "",
                session_id: sid,
              };
              if (navigator.sendBeacon) navigator.sendBeacon("/api/track", JSON.stringify(payload));
            } catch (_e) {
              /* noop */
            }
          });
        } else {
          mainVideo.removeAttribute("src");
          showVideo(false);
        }
      }

      const thumbs = document.getElementById("pdp-thumbnails");
      thumbs.innerHTML = "";

      function markActive(btn) {
        const allBtns = thumbs.querySelectorAll(".pdp-thumb-btn");
        for (let k = 0; k < allBtns.length; k++) allBtns[k].classList.remove("active");
        btn.classList.add("active");
      }

      // Video thumbnail first (cover image + play badge)
      if (videoUrl) {
        const vbtn = document.createElement("button");
        vbtn.type = "button";
        vbtn.className = "pdp-thumb-btn active";
        vbtn.title = "Video";
        vbtn.setAttribute("aria-label", "Play product video");
        vbtn.style.position = "relative";
        vbtn.innerHTML =
          '<img src="' +
          esc(images[0]) +
          '" alt="' +
          esc(p.title) +
          ' video" onerror="this.style.display=\'none\'" />' +
          '<span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.28);color:#fff;font-size:20px;line-height:1;">&#9654;</span>';
        vbtn.addEventListener("click", function () {
          showVideo(true);
          markActive(vbtn);
        });
        thumbs.appendChild(vbtn);
      }

      for (let j = 0; j < images.length; j++) {
        (function (idx) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "pdp-thumb-btn" + (!videoUrl && idx === 0 ? " active" : "");
          btn.innerHTML =
            '<img src="' +
            esc(images[idx]) +
            '" alt="' +
            esc(p.title) +
            " view " +
            (idx + 1) +
            '" onerror="this.parentNode.style.display=\'none\'" />';
          btn.addEventListener("click", function () {
            showVideo(false);
            mainImg.dataset.fb = "";
            mainImg.src = images[idx];
            markActive(btn);
          });
          thumbs.appendChild(btn);
        })(j);
      }

      renderHeroPackaging(p);
    }

    // Packaging facts under the gallery (Product Size / Unit Weight / Units per
    // Carton / Carton Volume) — same real data as the Packaging & Shipping
    // section, rendered as muted aligned cards per the design reference.
    // No fabrication: block stays hidden when no real data exists.
    function renderHeroPackaging(p) {
      const box = document.getElementById("pdp-hero-packaging");
      if (!box) return;

      // Use first variant with dimensions; otherwise fall back to product-level
      // parcel dimensions (excel imports store the supplier's single-item package
      // size in carton_* columns). Never guess — only real source data.
      const variants = p.variants || [];
      let ref = null;
      for (let i = 0; i < variants.length; i++) {
        if (variants[i].length_cm || variants[i].weight_kg) {
          ref = variants[i];
          break;
        }
      }
      if (
        !ref &&
        (p.carton_length_cm ||
          p.carton_width_cm ||
          p.carton_height_cm ||
          p.carton_weight_kg ||
          p.weight)
      ) {
        ref = {
          length_cm: p.carton_length_cm,
          width_cm: p.carton_width_cm,
          height_cm: p.carton_height_cm,
          weight_kg: p.carton_weight_kg || p.weight,
        };
      }

      let size = "To be confirmed";
      if (ref && (ref.length_cm || ref.width_cm || ref.height_cm)) {
        size =
          (ref.length_cm || "?") +
          " × " +
          (ref.width_cm || "?") +
          " × " +
          (ref.height_cm || "?") +
          " cm";
      }
      const weight = ref && ref.weight_kg ? ref.weight_kg + " kg" : "To be confirmed";
      const pcsPerCarton = parseInt(p.units_per_carton) || 0;
      const carton = pcsPerCarton > 0 ? pcsPerCarton + " pcs" : "To be confirmed";

      const hasReal =
        size !== "To be confirmed" || weight !== "To be confirmed" || pcsPerCarton > 0;
      if (!hasReal) return; // nothing real to show — keep block hidden

      const cells = [
        ["Product Size", size],
        ["Unit Weight", weight],
        ["Units / Carton", carton],
        ["Carton Volume", "To be confirmed"],
      ];
      let html = '<div class="grid grid-cols-2 gap-2 sm:grid-cols-4">';
      for (let c = 0; c < cells.length; c++) {
        html +=
          '<div class="rounded-lg border border-line bg-card px-3 py-2.5">' +
          '<p class="text-[10px] font-medium uppercase tracking-wide text-stone">' +
          esc(cells[c][0]) +
          "</p>" +
          '<p class="mt-0.5 text-xs font-semibold text-ink">' +
          esc(cells[c][1]) +
          "</p></div>";
      }
      html += "</div>";
      box.innerHTML = html;
      box.classList.remove("hidden");
    }

    function renderPurchasePanel(p) {
      // Display H1: prefer clean short_name (de-stuffed, de-duped, <=60), fallback seo_title -> original long title
      const h1Name = displayName(p);
      // SEO <title>: keep keyword-rich seo_title / original title
      // 防御：部分 seo_title 以 " | " 等分隔符结尾（历史截断产物），直接拼 " | Aromiso"
      // 会产生 "... | | Aromiso" 双竖线。这里仅在做显示层清理，不改动任何数据。
      const seoName = String(p.seo_title || p.title || "")
        .replace(/[\s|·•\-–—/]+$/u, "")
        .trim();
      document.getElementById("pdp-title").textContent = h1Name;

      // ---- Audit D01: three-state short_description render; never leave a blank that looks normal ----
      const shortEl = document.getElementById("pdp-short-desc");
      const pendingEl = document.getElementById("pdp-copy-pending");
      const shortCopy = plainText(p.short_description);
      const longCopy = plainText(p.description);
      if (shortCopy) {
        // (1) real copy present -> render normally
        shortEl.textContent = shortCopy;
        shortEl.classList.remove("hidden");
        if (pendingEl) pendingEl.classList.add("hidden");
      } else if (longCopy) {
        // (2) short missing but long available -> cleanly omit this line (Product Details below
        //    renders the full text); no blank gap pretending to be a short description.
        shortEl.textContent = "";
        shortEl.classList.add("hidden");
        if (pendingEl) pendingEl.classList.add("hidden");
      } else {
        // (3) required copy fully missing -> explicit incomplete state telling buyers copy is not ready.
        shortEl.textContent = "";
        shortEl.classList.add("hidden");
        if (pendingEl) pendingEl.classList.remove("hidden");
      }

      // SEO: document title + meta description from real product fields
      if (seoName) {
        document.title = seoName + " | Aromiso";
      }
      // Audit D01: old code `seo_description || short_description || ""` yielded empty for all 2431
      // products; falling back to description directly would dump `<p>…</p>` source into
      // meta. Use deriveCopy (strip tags + first sentence + <=160); with no source leave meta tags untouched,
      // preserving edge-middleware values instead of overwriting with empty.
      const metaDesc =
        plainText(p.seo_description) || deriveCopy(p.short_description, p.description, 160);
      if (metaDesc) {
        let metaEl = document.querySelector('meta[name="description"]');
        if (!metaEl) {
          metaEl = document.createElement("meta");
          metaEl.setAttribute("name", "description");
          document.head.appendChild(metaEl);
        }
        metaEl.setAttribute("content", metaDesc);
      }
      // Canonical URL — make it unique per product
      const canonicalUrl =
        window.location.origin + window.location.pathname + window.location.search;
      const canonicalEl = document.querySelector('link[rel="canonical"]');
      if (canonicalEl) canonicalEl.setAttribute("href", canonicalUrl);
      // Open Graph tags for social sharing and SEO
      const ogTitle = seoName + " | Aromiso";
      const ogDesc = metaDesc;
      const ogImg = p.cover_image || "";
      ["og:title", "twitter:title"].forEach(function (attr) {
        const el = document.querySelector(
          'meta[property="' + attr + '"], meta[name="' + attr + '"]',
        );
        if (el) el.setAttribute("content", ogTitle);
      });
      ["og:description", "twitter:description"].forEach(function (attr) {
        const el = document.querySelector(
          'meta[property="' + attr + '"], meta[name="' + attr + '"]',
        );
        if (el) el.setAttribute("content", ogDesc);
      });
      if (ogImg) {
        const el = document.querySelector('meta[property="og:image"]');
        if (el) el.setAttribute("content", ogImg);
      }
      const ogUrlEl = document.querySelector('meta[property="og:url"]');
      if (ogUrlEl) ogUrlEl.setAttribute("content", canonicalUrl);

      // Badges
      const badges = [];
      if (p.stock_status === "in_stock" || p.stock_status === "ready_to_ship") {
        badges.push({
          label: "Curated & Verified",
          cls: "bg-green-50 text-green-700 border-green-200",
        });
        badges.push({
          label: "Ready to Ship",
          cls: "bg-teal-50 text-teal-700 border-teal-200",
        });
      }
      if (p.oem_available) {
        badges.push({ label: "OEM Available", cls: "bg-blue-50 text-blue-700 border-blue-200" });
      }
      badges.push({
        label: "Sample Available",
        cls: "bg-amber-50 text-amber-700 border-amber-200",
      });

      const badgesEl = document.getElementById("pdp-badges");
      badgesEl.innerHTML = "";
      for (let i = 0; i < badges.length; i++) {
        badgesEl.innerHTML +=
          '<span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium ' +
          badges[i].cls +
          '">' +
          esc(badges[i].label) +
          "</span>";
      }

      // Price Display — prominent range
      const tiers = p.price_tiers || [];
      // Deduplicate tiers (API returns one per variant, causing massive duplicates)
      const tierMap = {};
      for (let ti = 0; ti < tiers.length; ti++) {
        const key = tiers[ti].min_qty + "|" + (tiers[ti].max_qty || "null");
        if (!tierMap[key] || tiers[ti].unit_price < tierMap[key].unit_price) {
          tierMap[key] = tiers[ti];
        }
      }
      const uniqueTiers = Object.values(tierMap).sort(function (a, b) {
        return a.min_qty - b.min_qty || a.unit_price - b.unit_price;
      });

      const priceMainEl = document.getElementById("pdp-price-main");
      const priceFromEl = document.getElementById("pdp-price-from");
      const priceUnitEl = document.getElementById("pdp-price-unit");
      const priceHintEl = document.getElementById("pdp-price-tier-hint");
      if (uniqueTiers.length) {
        const currency = uniqueTiers[0].currency || "USD";
        const sym = currency === "EUR" ? "\u20AC" : currency === "GBP" ? "\u00A3" : "$";
        const prices = uniqueTiers.map(function (t) {
          return t.unit_price;
        });
        const lowPrice = Number(Math.min.apply(null, prices)).toFixed(2);
        const highPrice = Number(Math.max.apply(null, prices)).toFixed(2);
        if (lowPrice === highPrice) {
          priceMainEl.textContent = sym + lowPrice;
          priceFromEl.textContent = "";
        } else {
          priceMainEl.textContent = sym + lowPrice + " \u2013 " + sym + highPrice;
          priceFromEl.textContent = "";
        }
        priceUnitEl.textContent = "/ " + (p.unit || "piece");
        priceHintEl.textContent =
          "MOQ " +
          (p.moq || 1) +
          " " +
          (p.unit || "pcs") +
          (uniqueTiers.length > 1 ? " · Volume pricing available" : " · Contact for bulk pricing");
      } else {
        priceMainEl.textContent = "Contact for price";
        priceMainEl.style.fontSize = "1.25rem";
        priceFromEl.textContent = "";
        priceUnitEl.textContent = "";
        priceHintEl.textContent = "Request a quote for bulk orders";
      }

      // B2B Info Cards - populate above-fold key info
      const moqCard = document.getElementById("pdp-info-moq");
      if (moqCard) {
        moqCard.textContent = (p.moq || 1) + " " + (p.unit || "pcs");
      }
      const stockCard = document.getElementById("pdp-info-stock");
      if (stockCard) {
        const st = p.stock_status || "in_stock";
        if (st === "out_of_stock") {
          stockCard.textContent = "Out of Stock";
          stockCard.className = "mt-1 text-sm font-semibold text-red-600";
        } else if (st === "pre_order") {
          stockCard.textContent = "Pre-order";
          stockCard.className = "mt-1 text-sm font-semibold text-amber-600";
        } else {
          stockCard.textContent = "In Stock";
          stockCard.className = "mt-1 text-sm font-semibold text-green-700";
        }
      }
      const sampleCard = document.getElementById("pdp-info-sample");
      if (sampleCard) {
        sampleCard.textContent = p.sample_available ? "Available" : "Contact us";
        sampleCard.className = p.sample_available
          ? "mt-1 text-sm font-semibold text-green-700"
          : "mt-1 text-sm font-semibold text-ink";
      }
      const oemCard = document.getElementById("pdp-info-oem");
      if (oemCard) {
        oemCard.textContent = p.oem_available ? "Supported" : "Contact us";
      }

      // Price tiers table (uses uniqueTiers computed above)
      const tiersEl = document.getElementById("pdp-price-tiers");
      tiersEl.innerHTML = "";
      if (uniqueTiers.length >= 2) {
        for (let t = 0; t < uniqueTiers.length; t++) {
          const tier = uniqueTiers[t];
          const range = tier.min_qty + (tier.max_qty ? " \u2013 " + tier.max_qty : "+");
          const isLast = t === uniqueTiers.length - 1;
          tiersEl.innerHTML +=
            '<tr class="' +
            (isLast ? "" : "border-b border-line/60") +
            '">' +
            '<td class="px-4 py-3">' +
            range +
            " " +
            esc(p.unit || "pcs") +
            "</td>" +
            '<td class="px-4 py-3 font-semibold text-ink">' +
            formatPrice(tier.unit_price, tier.currency) +
            "</td>" +
            "</tr>";
        }
      } else {
        document.getElementById("pdp-price-section").classList.add("hidden");
      }

      // Variants (axis-based selector)
      const variants = p.variants || [];
      if (variants.length) {
        document.getElementById("pdp-variant-section").classList.remove("hidden");
        renderAxisSelector(p, variants);
      }

      // Populate supply information
      populateSupplyInfo(p);

      // Populate shipping & packaging
      populateShippingPackaging(p, variants);

      // Quantity + MOQ
      const moq = p.moq || 1;
      const qtyInput = document.getElementById("pdp-qty");
      qtyInput.value = moq;
      qtyInput.min = moq;
      document.getElementById("pdp-moq-note").textContent =
        "Min. order: " + moq + " " + (p.unit || "pcs");

      // Mobile bar — use deduplicated tiers
      const lowestUnique = uniqueTiers.length
        ? uniqueTiers.reduce(function (a, b) {
            return a.unit_price < b.unit_price ? a : b;
          })
        : null;
      const lowestPrice = lowestUnique
        ? formatPrice(lowestUnique.unit_price, lowestUnique.currency)
        : "Contact for price";
      document.getElementById("pdp-mobile-price").textContent = lowestPrice;
      document.getElementById("pdp-mobile-moq").textContent =
        "MOQ: " + moq + " " + (p.unit || "pcs");

      // Volume incentive hint (initial render)
      updateVolumeHint(p);
      updateOrderSummary(p);

      // OEM CTA link with product context
      const oemCtaLink = document.getElementById("pdp-oem-cta-link");
      if (oemCtaLink) {
        oemCtaLink.href = oemHref + "?product=" + encodeURIComponent(p.slug);
      }
    }

    // ---- Volume Incentive Hint ----
    function updateVolumeHint(p) {
      const hintEl = document.getElementById("pdp-volume-hint");
      if (!hintEl) return;
      // Deduplicate tiers (API returns one per variant)
      const rawTiers = p.price_tiers || [];
      const tierMap = {};
      for (let i = 0; i < rawTiers.length; i++) {
        const key = rawTiers[i].min_qty + "|" + (rawTiers[i].max_qty || "null");
        if (!tierMap[key] || rawTiers[i].unit_price < tierMap[key].unit_price) {
          tierMap[key] = rawTiers[i];
        }
      }
      const tiers = Object.values(tierMap).sort(function (a, b) {
        return a.min_qty - b.min_qty;
      });
      if (tiers.length < 2) {
        hintEl.classList.add("hidden");
        return;
      }
      const qtyInput = document.getElementById("pdp-qty");
      const qty = parseInt(qtyInput.value) || p.moq || 1;

      // Find current tier index
      let currentIdx = 0;
      for (let i = 0; i < tiers.length; i++) {
        if (qty >= tiers[i].min_qty) {
          currentIdx = i;
        }
      }

      // If there is a next tier, show incentive
      if (currentIdx < tiers.length - 1) {
        const nextTier = tiers[currentIdx + 1];
        const needed = nextTier.min_qty - qty;
        const nextPrice = formatPrice(nextTier.unit_price, nextTier.currency);
        hintEl.innerHTML =
          '<span class="font-semibold">\u{1F4A1}</span> Buy <strong>' +
          needed +
          "</strong> more to unlock <strong>" +
          nextPrice +
          "/" +
          esc(p.unit || "unit") +
          "</strong>";
        hintEl.classList.remove("hidden");
      } else {
        // Already at best tier
        hintEl.innerHTML =
          '<span class="font-semibold">\u2705</span> You are at the <strong>best volume price</strong>!';
        hintEl.classList.remove("hidden");
      }
    }

    function renderSpecs(p) {
      const specs = [
        {
          label: "Category",
          value: p.category
            ? p.category.replace(/-/g, " ").replace(/\b\w/g, function (c) {
                return c.toUpperCase();
              })
            : null,
        },
        { label: "MOQ", value: p.moq ? p.moq + " " + (p.unit || "pcs") : null },
        {
          label: "Stock Status",
          value: p.stock_status
            ? p.stock_status.replace(/_/g, " ").replace(/\b\w/g, function (c) {
                return c.toUpperCase();
              })
            : null,
        },
        { label: "Unit", value: p.unit },
        { label: "OEM/ODM", value: p.oem_available ? "Available" : "Not available" },
        {
          label: "Certifications",
          value: p.certifications && p.certifications.length ? p.certifications.join(", ") : null,
        },
      ];

      // Add dynamic specifications from normalized attributes
      if (p.specifications && typeof p.specifications === "object") {
        const specKeys = Object.keys(p.specifications);
        for (let si = 0; si < specKeys.length; si++) {
          const rawKey = specKeys[si];
          const specVal = p.specifications[rawKey];
          if (specVal) {
            const rawVal = String(specVal);
            // Specifications CJK 治理 (FINAL batch, render-time display layer ONLY):
            // delegate to the unit-tested, CONTEXT-AWARE module exposed by the bundled script
            // above (window.__aromisoSpecLoc). It localizes a value based on its KEY/field
            // semantics (产地=浙江→Zhejiang but 品牌=攀潮 stays), parses digit durations
            // deterministically, and PRESERVES brands / commercial scent names / numeric-Chinese /
            // ambiguous values unchanged. Never fabricates, never hides, never mutates source
            // (p.specifications / D1 / import data). Fallback to raw if the module isn't ready.
            const fallbackLabel = rawKey.replace(/_/g, " ").replace(/\b\w/g, function (c) {
              return c.toUpperCase();
            });
            const loc = window.__aromisoSpecLoc;
            const label = loc ? loc.localizeSpecKey(rawKey, fallbackLabel) : fallbackLabel;
            const value = loc ? loc.localizeSpecValue(rawVal, rawKey) : rawVal;
            specs.push({ label: label, value: value });
          }
        }
      }

      const tbody = document.getElementById("pdp-specs-table");
      tbody.innerHTML = "";
      // Level 2: Core specs (first 6)
      const CORE_SPECS = 12;
      const showAllSpecs = specs.length <= CORE_SPECS;
      let rowIdx = 0;
      const maxShow = showAllSpecs ? specs.length : CORE_SPECS;
      for (let i = 0; i < maxShow; i++) {
        if (!specs[i].value) continue;
        const bg = rowIdx % 2 === 0 ? "bg-beige/30" : "";
        tbody.innerHTML +=
          '<tr class="' +
          bg +
          '">' +
          '<td class="w-1/3 px-5 py-3.5 font-medium text-ink">' +
          esc(specs[i].label) +
          "</td>" +
          '<td class="px-5 py-3.5 text-stone">' +
          esc(specs[i].value) +
          "</td>" +
          "</tr>";
        rowIdx++;
      }

      // V5.16: hide the whole section when there is nothing to show
      if (rowIdx === 0) {
        const sec = document.getElementById("pdp-specs-section");
        if (sec) sec.classList.add("hidden");
        return;
      }

      // Level 3: Full Technical Data (collapsible)
      if (!showAllSpecs) {
        const wrap = document.getElementById("pdp-full-specs-wrap");
        const body = document.getElementById("pdp-full-specs-body");
        const tbodyFull = document.getElementById("pdp-full-specs-table");
        const toggleBtn = document.getElementById("pdp-full-specs-toggle");
        const chevron = document.getElementById("pdp-full-specs-chevron");
        if (wrap) wrap.classList.remove("hidden");
        const btnSpan = toggleBtn ? toggleBtn.querySelector("span") : null;
        if (btnSpan) btnSpan.textContent = i18n.full_specs_btn;
        tbodyFull.innerHTML = "";
        for (let i = 0; i < specs.length; i++) {
          if (!specs[i].value) continue;
          tbodyFull.innerHTML +=
            '<tr class="' +
            (i % 2 === 0 ? "bg-beige/30" : "") +
            '">' +
            '<td class="w-1/3 px-5 py-3.5 font-medium text-ink">' +
            esc(specs[i].label) +
            "</td>" +
            '<td class="px-5 py-3.5 text-stone">' +
            esc(specs[i].value) +
            "</td></tr>";
        }
        if (toggleBtn) {
          toggleBtn.onclick = function () {
            const open = !body.classList.contains("hidden");
            body.classList.toggle("hidden");
            if (chevron) chevron.style.transform = open ? "rotate(0deg)" : "rotate(180deg)";
          };
        }
      }
    }

