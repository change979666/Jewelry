---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { localizedUrl, t, type Locale } from "../../i18n";
import { requireLocale } from "../../lib/locale";

const _locale = requireLocale(Astro.params.lang);
if (_locale instanceof Response) return _locale;
const locale = _locale;
const href = (p: string) => localizedUrl(locale, p);

// V1.0: jewelry-store FAQ, hand-written per locale (no machine translation).
const FAQ: Record<Locale, { q: string; a: string }[]> = {
  en: [
    {
      q: "Which countries do you ship to?",
      a: "We currently ship within Saudi Arabia and the United Arab Emirates. Delivery typically takes 2–5 business days for KSA and 3–7 business days for UAE.",
    },
    {
      q: "What payment methods do you accept?",
      a: "Cash on Delivery (COD) is available for all orders. Online card payment will be enabled soon.",
    },
    {
      q: "How much is shipping?",
      a: "Shipping is a flat SAR 15 in KSA and AED 20 in UAE. Orders over SAR 300 (KSA) or AED 300 (UAE) ship free.",
    },
    {
      q: "Can I return or exchange an item?",
      a: "Yes. Unworn items in original packaging can be returned within 14 days of delivery. Contact our support team with your order number to start a return.",
    },
    {
      q: "Are your pieces real gold and silver?",
      a: "Gold pieces are 18K gold; silver pieces are 925 sterling silver. Each piece is stamped and ships with a certificate of authenticity.",
    },
    {
      q: "How do I track my order?",
      a: "You will receive a confirmation with your order number at checkout. Our team shares tracking details by SMS or email once the order ships.",
    },
  ],
  ar: [
    {
      q: "إلى أي دول تشحنون؟",
      a: "نشحن حاليًا داخل المملكة العربية السعودية ودولة الإمارات. تستغرق التوصيل عادة من ٢ إلى ٥ أيام عمل في السعودية ومن ٣ إلى ٧ أيام عمل في الإمارات.",
    },
    {
      q: "ما وسائل الدفع المتاحة؟",
      a: "الدفع عند الاستلام متاح لجميع الطلبات. سيتم قريبًا تفعيل الدفع الإلكتروني بالبطاقات.",
    },
    {
      q: "كم تكلفة الشحن؟",
      a: "الشحن بسعر ثابت: ١٥ ريالًا في السعودية و٢٠ درهمًا في الإمارات. الشحن مجاني للطلبات فوق ٣٠٠ ريال (السعودية) أو ٣٠٠ درهم (الإمارات).",
    },
    {
      q: "هل يمكنني الإرجاع أو الاستبدال؟",
      a: "نعم. يمكن إرجاع القطع غير المستخدمة في تغليفها الأصلي خلال ١٤ يومًا من التوصيل. تواصل مع فريق الدعم مع رقم طلبك لبدء الإرجاع.",
    },
    {
      q: "هل المجوهرات ذهب وفضة حقيقية؟",
      a: "قطع الذهب من عيار ١٨، وقطع الفضة من الفضة الإسترلينية ٩٢٥. كل قطعة مختومة وتُشحن مع شهادة أصالة.",
    },
    {
      q: "كيف أتتبع طلبي؟",
      a: "ستتلقى رقم طلبك عند إتمام الشراء. يرسل فريقنا تفاصيل التتبع عبر الرسائل النصية أو البريد الإلكتروني فور شحن الطلب.",
    },
  ],
};
const faq = FAQ[locale] ?? FAQ.en;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Where-to-next cross-links (FAQ is a high-exit page — route visitors deeper)
const nextLinks: {
  icon: string;
  href: string;
  label: string;
  desc: string;
}[] = [
  {
    icon: "truck",
    href: "/collection/everyday",
    label: locale === "ar" ? "تسوق المجوهرات" : "Shop Jewelry",
    desc:
      locale === "ar"
        ? "تصفح القطع المتوفرة مع شحن سريع خلال أيام."
        : "Browse in-stock pieces with fast dispatch.",
  },
  {
    icon: "gift",
    href: "/collection/gift",
    label: locale === "ar" ? "الهدايا" : "Gifts",
    desc:
      locale === "ar"
        ? "قطع هدايا مختارة بعناية لكل مناسبة."
        : "Hand-picked gift pieces for every occasion.",
  },
  {
    icon: "leaf",
    href: "/collection/new-arrivals",
    label: locale === "ar" ? "وصل حديثًا" : "New Arrivals",
    desc:
      locale === "ar"
        ? "أحدث القطع وصولًا إلى المجموعة."
        : "The latest pieces to land in the collection.",
  },
  {
    icon: "globe",
    href: "/contact",
    label: locale === "ar" ? "اتصل بنا" : "Contact Us",
    desc:
      locale === "ar"
        ? "فريقنا جاهز للإجابة عن استفساراتك."
        : "Our team is ready to answer your questions.",
  },
];
const nextTitle = locale === "ar" ? "إلى أين بعد ذلك؟" : "Where to Next?";
---

<BaseLayout
  locale={locale}
  title={t(locale, "nav.faq")}
  description={
    locale === "ar"
      ? "الأسئلة الشائعة حول الشحن والدفع عند الاستلام والإرجاع والمواد."
      : "Frequently asked questions about shipping, cash on delivery, returns and materials."
  }
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: t(locale, "nav.home"), href: "/" },
      { label: t(locale, "nav.faq"), href: "/faq" },
    ]}
  />

  <section class="container-x py-16 lg:py-24">
    <div class="mx-auto max-w-2xl text-center reveal">
      <p class="eyebrow">{t(locale, "nav.faq")}</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        {locale === "ar" ? "الأسئلة الشائعة" : "Frequently Asked Questions"}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-stone">
        {
          locale === "ar"
            ? "إجابات عن أهم الأسئلة حول الطلب والشحن والدفع."
            : "Answers to the key questions about ordering, shipping and payment."
        }
      </p>
    </div>
  </section>

  <section class="container-x pb-12">
    <div class="mx-auto max-w-3xl space-y-4">
      {
        faq.map((item, i) => (
          <details
            id={`faq-${i}`}
            class="reveal faq-item group scroll-mt-24 rounded-2xl border border-line bg-card p-6 transition-colors open:border-accent/40"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium">
              <span>{item.q}</span>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-beige text-accent transition-transform duration-300 group-open:rotate-45">
                <Icon name="close" size={14} />
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Where to next -->
  <section class="container-x pb-16">
    <h2 class="mb-8 text-center text-2xl font-semibold">{nextTitle}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        nextLinks.map((l) => (
          <a
            href={href(l.href)}
            class="card-surface group rounded-xl p-5 transition-shadow hover:shadow-md"
          >
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent/10 text-accent">
              <Icon name={l.icon} size={18} />
            </span>
            <h3 class="mt-3 text-sm font-semibold group-hover:text-accent transition-colors">
              {l.label}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-stone">{l.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand locale={locale} />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Auto-expand the question targeted by a #faq-N anchor (global search deep links) -->
  <script is:inline>
    (function () {
      const h = location.hash;
      if (/^#faq-\d+$/.test(h)) {
        const el = document.querySelector(h);
        if (el) el.setAttribute("open", "");
      }
    })();
  </script>
</BaseLayout>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
