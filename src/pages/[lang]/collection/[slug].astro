---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCommerce } from "../../../lib/commerce";
import { t } from "../../../i18n";
import { requireLocale } from "../../../lib/locale";

const { slug, lang } = Astro.params;
const _locale = requireLocale(lang);
if (_locale instanceof Response) return _locale;
const locale = _locale;

const db = Astro.locals.runtime.env.DB;
if (!db) return new Response("Database unavailable", { status: 503 });

const commerce = getCommerce(db);
const collection = await commerce.collections.getBySlug(slug as string);

if (!collection || collection.status !== 'active') {
  return new Response("Not Found", { status: 404 });
}

// Pagination + sort (server-side, indexed queries only)
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const pageSize = 24;
const sortRaw = Astro.url.searchParams.get('sort') || 'newest';
const sort = (['newest', 'price_asc', 'price_desc', 'title'] as const).includes(sortRaw as any)
  ? sortRaw as 'newest' | 'price_asc' | 'price_desc' | 'title'
  : 'newest';

const { products, total } = await commerce.collections.listProducts({
  collectionId: collection.id,
  limit: pageSize,
  offset: (page - 1) * pageSize,
  sort,
});
const totalPages = Math.max(1, Math.ceil(total / pageSize));

const sortUrl = (s: string) => `/${lang}/collection/${collection.slug}?sort=${s}&page=1`;
const pageUrl = (p: number) => `/${lang}/collection/${collection.slug}?sort=${sort}&page=${p}`;

const formatMoney = (price: number, currency: string) =>
  new Intl.NumberFormat(locale, { style: 'currency', currency }).format(price / 100);

// Cover image per product (first variant price)
const variantRows = products.length
  ? await db.prepare(
      `SELECT product_id, MIN(price) AS min_price FROM product_variants WHERE status = 'active' AND product_id IN (${products.map(() => '?').join(',')}) GROUP BY product_id`,
    ).bind(...products.map(p => p.id)).all<{ product_id: string; min_price: number }>()
  : { results: [] as any[] };
const priceMap = Object.fromEntries((variantRows.results || []).map(r => [r.product_id, r.min_price]));

const mediaRows = products.length
  ? await db.prepare(
      `SELECT product_id, url FROM product_media WHERE type IN ('hero','gallery') AND product_id IN (${products.map(() => '?').join(',')}) ORDER BY sort_order ASC`,
    ).bind(...products.map(p => p.id)).all<{ product_id: string; url: string }>()
  : { results: [] as any[] };
const coverMap: Record<string, string> = {};
for (const m of mediaRows.results || []) if (!coverMap[m.product_id]) coverMap[m.product_id] = m.url;
---

<BaseLayout locale={locale} title={collection.seo_title || collection.name} description={collection.seo_description || collection.description || ""}>
  <main class="container-x py-12">
    <header class="text-center mb-10">
      <h1 class="text-4xl font-bold">{collection.name}</h1>
      {collection.description && <p class="mt-3 text-stone max-w-xl mx-auto">{collection.description}</p>}
    </header>

    {products.length > 0 && (
      <div class="flex justify-between items-center mb-6 text-sm">
        <span class="text-stone">{total} {t(locale, "collection.products_count")}</span>
        <label class="flex items-center gap-2">
          <span class="text-stone">{t(locale, "collection.sort_label")}</span>
          <select onchange={`window.location.href=this.value`} class="border border-line rounded px-2 py-1 bg-surface">
            <option value={sortUrl('newest')} selected={sort === 'newest'}>{t(locale, "collection.sort_newest")}</option>
            <option value={sortUrl('price_asc')} selected={sort === 'price_asc'}>{t(locale, "collection.sort_price_asc")}</option>
            <option value={sortUrl('price_desc')} selected={sort === 'price_desc'}>{t(locale, "collection.sort_price_desc")}</option>
            <option value={sortUrl('title')} selected={sort === 'title'}>{t(locale, "collection.sort_title")}</option>
          </select>
        </label>
      </div>
    )}

    {products.length === 0 ? (
      <div class="text-center py-16 border border-dashed border-line rounded-xl">
        <p class="text-stone">{t(locale, "collection.empty")}</p>
        <a href={`/${lang}/`} class="btn btn-primary mt-4 inline-block">{t(locale, "collection.back_home")}</a>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {products.map(p => (
            <a href={`/${lang}/product/${p.slug}`} class="block group">
              <div class="aspect-square bg-beige rounded-xl overflow-hidden mb-3">
                {coverMap[p.id]
                  ? <img src={coverMap[p.id]} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center text-stone text-sm">No Image</div>}
              </div>
              <h2 class="font-semibold text-sm">{p.title}</h2>
              {priceMap[p.id] != null && (
                <p class="text-accent mt-1 text-sm">{formatMoney(priceMap[p.id], 'SAR')}</p>
              )}
            </a>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="mt-10 flex justify-center gap-2" aria-label="Pagination">
            {page > 1 && <a class="btn btn-secondary" href={pageUrl(page - 1)}>← {t(locale, "collection.prev")}</a>}
            <span class="px-3 py-2 text-sm text-stone">{page} / {totalPages}</span>
            {page < totalPages && <a class="btn btn-secondary" href={pageUrl(page + 1)}>{t(locale, "collection.next")} →</a>}
          </nav>
        )}
      </>
    )}
  </main>
</BaseLayout>
