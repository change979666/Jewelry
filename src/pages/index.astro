---
// Root "/" — redirect the visitor to their preferred locale.
//
// Replaces the retired functions/index.ts Pages Function with a server-side
// 302 so the decision is made before any HTML is sent (the previous
// meta-refresh fallback caused a visible flash and was invisible to crawlers).
// Falls back to English.
const accept = (Astro.request.headers.get("accept-language") || "").toLowerCase();
const locale = /\bar\b/.test(accept) || accept.startsWith("ar") ? "ar" : "en";
return Astro.redirect(`/${locale}`, 302);
---
