---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../consts";
import { getProducts, getBlogPosts, getGuides } from "../lib/content";

const locale = "en";

// Dynamic navigation aids to reduce bounce
const products = (await getProducts(locale)).slice(0, 3);
const posts = (await getBlogPosts(locale)).slice(0, 3);
const guides = (await getGuides(locale)).slice(0, 3);
---

<BaseLayout locale={locale} title="Page not found">
  <section class="container-x flex flex-col items-center justify-center pt-24 pb-12 text-center">
    <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-ink text-paper">
      <Icon name="leaf" size={36} />
    </div>
    <p class="eyebrow mt-8">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">This page wandered off</h1>
    <p class="mt-3 max-w-md text-stone">
      The page you're looking for doesn't exist or may have moved. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/products" class="btn btn-ghost">Browse Products</a>
      <a href="/contact" class="btn btn-ghost">Contact Us</a>
    </div>
  </section>

  <!-- Popular products -->
  {
    products.length > 0 && (
      <section class="container-x pb-14">
        <h2 class="mb-6 text-center text-lg font-semibold text-stone">Popular Products</h2>
        <div class="grid gap-5 sm:grid-cols-3">
          {products.map((p) => (
            <a
              href={`/products/${p.data.key}`}
              class="card-surface group overflow-hidden rounded-xl transition-shadow hover:shadow-md"
            >
              <div class="aspect-[4/3] overflow-hidden bg-beige">
                {p.data.cover ? (
                  <img
                    src={p.data.cover}
                    alt={p.data.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                ) : (
                  <div class="grid h-full place-items-center text-accent/30">
                    <Icon name="drop" size={32} />
                  </div>
                )}
              </div>
              <div class="p-4">
                <h3 class="text-sm font-semibold leading-snug group-hover:text-accent transition-colors line-clamp-2">
                  {p.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Latest from the blog -->
  {
    posts.length > 0 && (
      <section class="container-x pb-14">
        <h2 class="mb-6 text-center text-lg font-semibold text-stone">Latest Insights</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.data.key}`}
              class="card-surface group rounded-xl p-5 transition-shadow hover:shadow-md"
            >
              <span class="text-xs font-medium text-accent">{post.data.category}</span>
              <h3 class="mt-2 text-sm font-semibold leading-snug group-hover:text-accent transition-colors line-clamp-2">
                {post.data.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Helpful guides -->
  {
    guides.length > 0 && (
      <section class="container-x pb-20">
        <h2 class="mb-6 text-center text-lg font-semibold text-stone">Helpful Guides</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {guides.map((g) => (
            <a
              href={`/resources/${g.data.key}`}
              class="card-surface group rounded-xl p-5 transition-shadow hover:shadow-md"
            >
              <span class="text-xs font-medium text-accent">{g.data.category}</span>
              <h3 class="mt-2 text-sm font-semibold leading-snug group-hover:text-accent transition-colors line-clamp-2">
                {g.data.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <p class="pb-10 text-center text-xs text-stone">{SITE.name} · {SITE.tagline}</p>
</BaseLayout>
