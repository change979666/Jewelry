---
// Reusable buyer-FAQ section (D4). Renders an accordion identical in style to
// the Solutions page FAQ. The FAQPage JSON-LD is emitted by the host page (so
// it can merge into that page's @graph); this component is display-only.
import Icon from "./Icon.astro";

interface Props {
  faqs: { q: string; a: string }[];
  title?: string;
}

const { faqs, title = "FAQ" } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="bg-surface py-16">
      <div class="container-x max-w-3xl">
        <h2 class="text-2xl font-semibold text-center mb-10">{title}</h2>
        <div class="space-y-4">
          {faqs.map((f) => (
            <details class="card-surface rounded-xl p-5 group">
              <summary class="cursor-pointer font-medium list-none flex items-center justify-between">
                {f.q}
                <Icon name="chevron" size={16} class="transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-stone">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
