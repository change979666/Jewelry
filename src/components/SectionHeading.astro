---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}
const { eyebrow, title, subtitle, align = "center" } = Astro.props;
---

<div class={`reveal max-w-2xl ${align === "center" ? "mx-auto text-center" : ""}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base leading-relaxed text-stone">{subtitle}</p>}
</div>
