---
// Sidebar — 左侧导航
// 统一使用 SVG 图标，子导航折叠
export interface Props {
  activeModule?: string;
}

const { activeModule = "dashboard" } = Astro.props;

// Sidebar navigation mirrors the pages that actually exist under
// src/pages/admin-v2. Modules planned in the spec but not yet built
// (Collections, Promotions) are intentionally NOT linked — add them here once
// their pages exist. (See 项目复制说明.txt §12.)
const navItems: any[] = [
  { header: "Catalog" },
  { id: "dashboard", icon: "grid", label: "Dashboard" },
  {
    id: "commerce",
    icon: "shopping-bag",
    label: "Catalog",
    children: [
      { id: "commerce/products", label: "Products" },
      { id: "commerce/orders", label: "Orders" },
    ],
  },
  { header: "Customers" },
  {
    id: "customers",
    icon: "users",
    label: "Customers",
    children: [
      { id: "customers/customer-list", label: "Customers" },
      { id: "customers/subscribers", label: "Subscribers" },
    ],
  },
  { header: "Content" },
  {
    id: "content",
    icon: "file-text",
    label: "Content",
    children: [
      { id: "content", label: "All content" },
      { id: "content/editor", label: "Editor" },
    ],
  },
  { id: "media", icon: "film", label: "Media" },
  { id: "growth/seo", icon: "trending-up", label: "SEO" },
  { header: "System" },
  {
    id: "system",
    icon: "settings",
    label: "System",
    children: [
      { id: "system/settings", label: "Settings" },
      { id: "system/users", label: "Users" },
      { id: "system/roles", label: "Roles" },
      { id: "system/audit-log", label: "Audit log" },
    ],
  },
];

const icons: Record<string, string> = {
  inbox:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>',
  grid: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
  "file-text":
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
  "shopping-bag":
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>',
  users:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  film: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/><line x1="17" y1="17" x2="22" y2="17"/></svg>',
  "trending-up":
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>',
  cpu: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>',
  settings:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
};

// Check if a module is active (exact match or parent of current page)
function isActive(id: string, activeModule: string, children?: { id: string }[]) {
  if (id === activeModule) return true;
  if (children) {
    return children.some((c) => activeModule === c.id || activeModule.startsWith(c.id + "/"));
  }
  return false;
}
---

{
  navItems.map((item) => {
    if (item.header) {
      return (
        <div style="padding:16px 12px 6px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--stone);font-weight:600;">
          {item.header}
        </div>
      );
    }
    const active = isActive(item.id, activeModule, item.children);
    const hasChildren = item.children && item.children.length > 0;
    return (
      <div>
        <a
          href={`/admin-v2/${item.id === "dashboard" ? "dashboard" : item.id}`}
          class={`admin-nav-item${active ? " active" : ""}`}
          data-module={item.id}
        >
          <span class="nav-icon" set:html={icons[item.icon] || ""} />
          <span>{item.label}</span>
          {hasChildren && (
            <span class="admin-nav-chevron" class:list={[{ "is-open": active }]}>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          )}
        </a>
        {hasChildren && (
          <div class="admin-nav-children" style={`display:${active ? "block" : "none"};`}>
            {item.children!.map((child: { id: string; label: string }) => (
              <a
                href={`/admin-v2/${child.id}`}
                class={`admin-nav-item admin-nav-child${activeModule === child.id ? " active" : ""}`}
              >
                <span>{child.label}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    );
  })
}
