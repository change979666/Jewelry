---
// Drawer — 右侧滑出面板
export interface Props {
  open: boolean;
  onClose?: string;
  title?: string;
  width?: string;
}
const { open, onClose, title = "", width = "480px" } = Astro.props;
---

{
  open && (
    <>
      <div class="admin-drawer-overlay" onclick={onClose ?? "void(0)"} />
      <div class="admin-drawer" role="dialog" aria-modal="true" style={`width:${width};`}>
        <div class="admin-drawer-header">
          <span>{title}</span>
          {onClose && (
            <button
              onclick={onClose}
              aria-label="关闭"
              style="background:none;border:none;cursor:pointer;font-size:var(--fs-lg);color:var(--stone);padding:0;line-height:1;"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          )}
        </div>
        <div class="admin-drawer-body">
          <slot />
        </div>
        {Astro.slots.has("footer") && (
          <div class="admin-drawer-footer">
            <slot name="footer" />
          </div>
        )}
      </div>
    </>
  )
}
