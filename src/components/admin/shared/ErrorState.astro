---
// ErrorState — 错误状态
export interface Props {
  title?: string;
  message?: string;
  retryLabel?: string;
  onRetry?: string;
}
const {
  title = "加载失败",
  message = "请检查网络连接后重试",
  retryLabel = "重试",
  onRetry,
} = Astro.props;
---

<div class="admin-error">
  <div class="admin-error-icon">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><path
        d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
      ></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"
      ></line></svg
    >
  </div>
  <div class="admin-error-title">{title}</div>
  <div class="admin-error-desc">{message}</div>
  {
    onRetry && (
      <button class="admin-btn admin-btn-secondary" onclick={onRetry}>
        {retryLabel}
      </button>
    )
  }
  <slot />
</div>
