---
interface TocItem {
  slug: string;
  text: string;
}
interface Props {
  headings: TocItem[];
  title: string;
}
const { headings, title } = Astro.props;
---

{
  headings.length >= 2 && (
    <nav class="rounded-2xl border border-line bg-card p-5" aria-label={title}>
      <p class="text-xs font-semibold uppercase tracking-wider text-stone">{title}</p>
      <ul class="mt-3 space-y-2 border-l border-line">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="toc-link -ml-px block border-l border-transparent pl-3 text-sm text-stone transition-colors hover:border-accent hover:text-accent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
