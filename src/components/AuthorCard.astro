---
interface Props {
  name: string;
  bio?: string;
  avatar?: string;
  label: string;
}
const { name, bio, avatar, label } = Astro.props;
const initial = (name || "A").trim().charAt(0).toUpperCase();
---

{
  (bio || avatar) && (
    <div class="reveal flex items-start gap-4 rounded-2xl border border-line bg-card p-6">
      {avatar ? (
        <img
          src={avatar}
          alt={name}
          loading="lazy"
          class="h-14 w-14 shrink-0 rounded-full object-cover"
        />
      ) : (
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-ink text-xl font-semibold text-paper">
          {initial}
        </span>
      )}
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone">{label}</p>
        <p class="mt-1 text-base font-semibold">{name}</p>
        {bio && <p class="mt-1.5 text-sm leading-relaxed text-stone">{bio}</p>}
      </div>
    </div>
  )
}
