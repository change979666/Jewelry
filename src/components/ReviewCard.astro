---
// ---------------------------------------------------------------------------
//  Aromiso — Customer review card (text testimonial, deliberately no star
//  ratings). Anonymized attribution: country + product type + buyer role,
//  matching the honest, no-fake-names trust direction from V1.9.
// ---------------------------------------------------------------------------
interface Props {
  quote: string;
  buyer: string;
  country: string;
  product: string;
}
const { quote, buyer, country, product } = Astro.props;
---

<figure
  class="reveal card-surface flex h-full flex-col rounded-2xl p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_-28px_rgba(33,31,27,0.45)]"
>
  <span class="font-serif text-5xl leading-[0.6] text-accent/30" aria-hidden="true">&ldquo;</span>
  <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-ink/90">{quote}</blockquote>
  <figcaption class="mt-6 border-t border-line pt-4">
    <p class="flex items-center gap-2 text-sm font-semibold">
      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
      {country} &middot; {product}
    </p>
    <p class="mt-1 pl-3.5 text-xs text-stone">{buyer}</p>
  </figcaption>
</figure>
