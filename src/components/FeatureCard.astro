---
import Icon from "./Icon.astro";
interface Props {
  icon?: string;
  title: string;
  desc: string;
  proof?: string;
}
const { icon = "check", title, desc, proof } = Astro.props;
---

<div
  class="reveal card-surface rounded-2xl p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_-28px_rgba(33,31,27,0.45)]"
>
  <span class="flex h-11 w-11 items-center justify-center rounded-full bg-beige text-accent">
    <Icon name={icon} size={22} />
  </span>
  <h3 class="mt-5 text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-stone">{desc}</p>
  {
    proof && (
      <p class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-accent">
        <Icon name="check" size={13} />
        {proof}
      </p>
    )
  }
</div>
