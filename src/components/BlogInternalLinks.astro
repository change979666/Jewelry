---
/**
 * BlogInternalLinks — build-time cross-links from blog posts to guides.
 * Rendered between article body and RelatedPosts. (Blog → product cross-links
 * were retired with the products content collection; catalog lives in D1.)
 */
import { localizedUrl, type Locale } from "../i18n";

interface GuideLink {
  data: { key: string; title: string; excerpt: string; category: string };
}

interface Props {
  locale: Locale;
  guides: GuideLink[];
}

const { locale, guides } = Astro.props;

const labels: Record<string, { guides: string; viewAll: string }> = {
  en: { guides: "Related Guides", viewAll: "View all" },
  ar: { guides: "أدلة ذات صلة", viewAll: "عرض الكل" },
};
const l = labels[locale] ?? labels.en;
---

{
  guides.length > 0 && (
    <section class="container-x mt-14">
      <div class="mx-auto max-w-5xl">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold tracking-tight">{l.guides}</h2>
          <a
            href={localizedUrl(locale, "/resources")}
            class="text-sm font-medium text-accent hover:underline"
          >
            {l.viewAll}
          </a>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          {guides.map((g) => (
            <a
              href={localizedUrl(locale, `/resources/${g.data.key}`)}
              class="group flex items-start gap-3 rounded-xl border border-line bg-white/60 p-4 transition-all hover:border-accent/30 hover:bg-beige/40"
            >
              <span class="mt-0.5 text-accent">📖</span>
              <span>
                <span class="block text-sm font-medium leading-snug group-hover:text-accent">
                  {g.data.title}
                </span>
                <span class="mt-1 block text-xs text-stone line-clamp-2">{g.data.excerpt}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
