---
import { t } from "../i18n";
import type { Locale } from "../i18n";
import { LOCALE_LIST } from "../i18n";

const _l = (Astro.currentLocale as Locale) ?? "en";
const locale = (LOCALE_LIST.includes(_l) ? _l : "en") as Locale;
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink transition-colors duration-300 hover:bg-beige"
  aria-label={t(locale, "a11y.theme_toggle")}
  title="Theme: light / dark / system"
>
  <span id="theme-icon" class="flex"></span>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle");
    const box = document.getElementById("theme-icon");
    const root = document.documentElement;
    const mq = window.matchMedia("(prefers-color-scheme: dark)");
    const order = ["light", "dark", "system"];
    const icons = {
      light:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
      dark: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>',
      system:
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/></svg>',
    };

    function stored() {
      return localStorage.getItem("theme") || "system";
    }
    function resolve(theme) {
      if (theme === "system") return mq.matches ? "dark" : "light";
      return theme;
    }
    function paint() {
      const theme = stored();
      box.innerHTML = icons[theme];
      btn.title = "Theme: " + theme;
    }
    function apply() {
      root.classList.toggle("dark", resolve(stored()) === "dark");
      paint();
    }

    btn.addEventListener("click", function () {
      const next = order[(order.indexOf(stored()) + 1) % order.length];
      localStorage.setItem("theme", next);
      apply();
    });
    mq.addEventListener("change", function () {
      if (stored() === "system") apply();
    });
    apply();
  })();
</script>
