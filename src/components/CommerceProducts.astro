---
/**
 * CommerceProducts — Render real-time product grid from D1 /api/commerce/products
 * Used on category landing pages to show Featured X products from shop catalog
 *
 * Props:
 * - locale?: "en" | "es" | "de" (defaults to "en"; prefixes all links)
 * - title?: string (section heading; e.g., "Featured Essential Oils")
 * - category?: string (API param: category name like "Essential Oils" or "Candles")
 * - rts?: boolean (include only Ready-to-Ship products)
 * - limit?: number (default 8)
 * - viewAllHref?: string (default "/shop" with category appended if provided)
 */

import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
  title?: string;
  category?: string; // category name exactly as stored in DB ("Essential Oils", etc.)
  rts?: boolean;
  limit?: number;
  viewAllHref?: string;
}

const {
  locale = "en",
  title = "Featured Products",
  category,
  rts = false,
  limit = 8,
  viewAllHref = category ? `/shop/?category=${encodeURIComponent(category)}` : "/shop",
} = Astro.props;

// Microcopy per locale (small strings not worth full i18n-content keys)
const ui: Record<
  string,
  {
    rts: string;
    bulk: string;
    view: string;
    viewAll: string;
    empty: string;
    noImage: string;
    moq: string;
    from: string;
  }
> = {
  en: {
    rts: "Ready to Ship",
    bulk: "Bulk pricing available",
    view: "View product →",
    viewAll: "View All Products →",
    empty: "No products found in this category at the moment.",
    noImage: "No Image",
    moq: "MOQ",
    from: "From",
  },
  es: {
    rts: "Listo para Enviar",
    bulk: "Precios al por mayor disponibles",
    view: "Ver producto →",
    viewAll: "Ver Todos los Productos →",
    empty: "No hay productos en esta categoría por el momento.",
    noImage: "Sin imagen",
    moq: "MOQ",
    from: "Desde",
  },
  de: {
    rts: "Ready to Ship",
    bulk: "Staffelpreise verfügbar",
    view: "Produkt ansehen →",
    viewAll: "Alle Produkte Ansehen →",
    empty: "In dieser Kategorie sind derzeit keine Produkte verfügbar.",
    noImage: "Kein Bild",
    moq: "MOQ",
    from: "Ab",
  },
};
const L = ui[locale] ?? ui.en;
const lhref = (p: string) => getRelativeLocaleUrl(locale, p);

const baseUrl = "https://aromiso.com";
const apiUrl = `${baseUrl}/api/commerce/products?sort=featured&limit=${limit}${
  category ? `&category=${encodeURIComponent(category)}` : ""
}${rts ? "&rts=1" : ""}`;

let productsData: unknown[] = [];
try {
  const res = await fetch(apiUrl, {
    headers: { Accept: "application/json" },
    cache: "no-cache",
  });
  const response: any = await res.json();
  if (response.ok && Array.isArray(response.products)) {
    productsData = response.products;
  }
} catch (e) {
  // Graceful degradation — render empty state instead of crashing
  console.error("CommerceProducts fetch failed:", e);
}

function esc(s: unknown): string {
  if (typeof s !== "string") return "";
  return s
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#x27;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

const isRTL = (p: any) => !!p.ready_to_ship || p.stock_status === "in_stock";
const hasBulkPricing = (tiers: any[]) => Array.isArray(tiers) && tiers.length >= 2;
const minPrice = (tiers: any[]) => {
  if (!Array.isArray(tiers) || !tiers.length) return null;
  let min = Infinity;
  for (const t of tiers) {
    const price = Number(t.price);
    if (!Number.isNaN(price) && price < min) min = price;
  }
  return Number.isFinite(min) ? min : null;
};

let loading = productsData.length === 0;
let items = Array.isArray(productsData) ? productsData.slice(0, limit) : [];
---

<section class="container-x py-12 lg:py-16" id="commerce-products-section">
  {
    title && (
      <div class="mb-8 text-center">
        <h2 class="text-2xl font-semibold tracking-tight">{esc(title)}</h2>
      </div>
    )
  }

  {
    loading ? (
      // Skeleton grid — V5.25 card layout with same aspect ratio and spacing
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {[...Array(limit)].map(() => (
          <div class="animate-pulse rounded-xl bg-beige p-3 shadow-sm">
            <div class="aspect-square w-full rounded-lg bg-stone/20" />
            <div class="mt-3 h-4 w-2/3 rounded bg-stone/10" />
            <div class="mt-2 h-3 w-1/2 rounded bg-stone/10" />
            <div class="mt-3 flex gap-2">
              <div class="h-3 w-1/3 rounded bg-stone/10" />
              <div class="h-3 w-1/3 rounded bg-stone/10" />
            </div>
          </div>
        ))}
      </div>
    ) : items.length === 0 ? (
      <p class="rounded-lg bg-beige/50 p-6 text-center text-sm text-stone">{L.empty}</p>
    ) : (
      <>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {items.map((p: any) => {
            const sku = p.short_id || p.slug || "";
            // V5.69 locale integrity: never render a CJK short_name on public pages.
            const titleEsc = esc(
              p.short_name && !/[\u4e00-\u9fff]/.test(p.short_name)
                ? p.short_name
                : p.title || p.short_name || "",
            );
            // Audit D01: the list API's LIST_COLUMNS has no long description, so the card
            // has no fallback copy. When the short description is missing we omit the
            // whole <p> instead of rendering a blank line that pretends to be a description.
            const hasDesc =
              typeof p.short_description === "string" && p.short_description.trim() !== "";
            const descEsc = esc(hasDesc ? p.short_description.trim() : "");
            const imgUrl = esc(p.cover_image || "");
            const tiers = Array.isArray(p.price_tiers) ? p.price_tiers : [];
            const priceFrom = minPrice(tiers);
            const rts = isRTL(p);
            const bulk = hasBulkPricing(tiers);

            return (
              <a
                href={lhref(`/shop/${sku}`)}
                data-product={sku}
                class="card-surface group overflow-hidden rounded-xl transition hover:shadow-md hover:-translate-y-0.5"
              >
                <div class="relative aspect-square overflow-hidden bg-beige">
                  {imgUrl ? (
                    <img
                      src={imgUrl}
                      alt={titleEsc}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-stone/10 text-stone/40 text-xs">
                      {L.noImage}
                    </div>
                  )}
                  {/* Badge: Ready to Ship */}
                  {rts && (
                    <span class="absolute left-2 top-2 rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-medium leading-none text-white">
                      {L.rts}
                    </span>
                  )}
                </div>
                <div class="p-3">
                  <h3 class="text-sm font-semibold leading-snug line-clamp-2">{titleEsc}</h3>
                  {hasDesc && <p class="mt-1 line-clamp-1 text-xs text-stone">{descEsc}</p>}
                  <div class="mt-2 space-y-1">
                    {priceFrom !== null && (
                      <p class="text-sm font-bold text-ink">
                        {L.from} ${Number(priceFrom).toFixed(2)}{" "}
                        <span class="text-[10px] text-stone">/pc</span>
                      </p>
                    )}
                    {bulk && <p class="text-[10px] text-accent">✓ {L.bulk}</p>}
                  </div>
                  <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-[10px] text-stone">
                    <span>
                      {L.moq} {p.moq || 100}
                    </span>
                    <span class="font-medium text-accent">{L.view}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {/* View All button */}
        {viewAllHref && items.length > 0 && (
          <div class="mt-8 text-center">
            <a
              href={lhref(viewAllHref)}
              class="inline-flex items-center gap-2 rounded-lg border border-line bg-card px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-stone/10"
            >
              {L.viewAll}
            </a>
          </div>
        )}
      </>
    )
  }
</section>

<script is:inline>
  // Trigger reveal animation when section mounts
  if (window.__initReveal) window.__initReveal();
</script>
